Public upstream PreviewProps only. See THIRD_PARTY_NOTICES.md for the MIT license. -->
<mjml>
  <mj-head>
    <mj-title>Log in with this magic link.</mj-title>
    <mj-preview>Log in with this magic link.</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="-apple-system,BlinkMacSystemFont,&#x27;Segoe UI&#x27;,Roboto,Oxygen-Sans,Ubuntu,Cantarell,&#x27;Helvetica Neue&#x27;,sans-serif"
      />
      <mj-text padding="0px" />
    </mj-attributes>
    <mj-style>
      p {
        margin: 0;
      }
      a {
        color: inherit;
      }
      .raycast-muted img {
        filter: grayscale(100%);
        -webkit-filter: grayscale(100%);
      }
      .community-rich-0 a:nth-of-type(1) {
        color: #ff6363;
        text-decoration: underline;
      }
    </mj-style>
  </mj-head>
  <mj-body width="600px" background-color="#ffffff">
    <mj-section
      padding="20px 25px 48px"
      background-url="https://demo.react.email/static/raycast-bg.png"
      background-position="center bottom"
      background-repeat="no-repeat"
      background-size="auto"
    >
      <mj-column padding="0px">
        <mj-image
          src="https://demo.react.email/static/raycast-logo.png"
          alt="Raycast"
          width="48px"
          height="48px"
          align="left"
          padding="0px"
        />
        <mj-text padding="48px 0px 24px" font-size="28px" line-height="1.3" font-weight="700"
          >🪄 Your magic link</mj-text
        >
        <mj-text
          padding="0px 0px 16px"
          font-size="16px"
          line-height="26px"
          css-class="community-rich-0"
          ><a href="https://raycast.com/">👉 Click here to sign in 👈</a>
        </mj-text>
        <mj-text padding="0px 0px 24px" font-size="16px" line-height="26px"
          >If you didn't request this, please ignore this email.</mj-text
        >
        <mj-text padding="0px" font-size="16px" line-height="26px"
          >Best,<br />- Raycast Team</mj-text
        >
        <mj-divider border-color="#dddddd" border-width="1px" padding="48px 0px 20px" />
        <mj-image
          src="https://demo.react.email/static/raycast-logo.png"
          alt=""
          width="32px"
          height="32px"
          align="left"
          padding="0px"
          css-class="raycast-muted"
        />
        <mj-text padding="20px 0px 12px 4px" font-size="12px" line-height="24px" color="#8898aa"
          >Raycast Technologies Inc.</mj-text
        >
        <mj-text padding="0px 0px 0px 4px" font-size="12px" line-height="24px" color="#8898aa"
          >2093 Philadelphia Pike #3222, Claymont, DE 19703</mj-text
        >
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
