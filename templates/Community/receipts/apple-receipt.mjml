<!-- Port of React Email's MIT-licensed demo; copyright React Email contributors.
Source: https://github.com/resend/react-email/blob/674d8ec2804b86be5d99156383fb1810179847bf/apps/demo/emails/Community/receipts/apple-receipt.tsx
Public upstream PreviewProps only. See THIRD_PARTY_NOTICES.md for the MIT license. -->
<mjml>
  <mj-head>
    <mj-title>Apple Receipt</mj-title>
    <mj-preview>Apple Receipt</mj-preview>
    <mj-attributes>
      <mj-all font-family="Helvetica Neue,Helvetica,Arial,sans-serif" />
      <mj-text padding="0px" />
    </mj-attributes>
    <mj-style>
      body {
        padding: 8px !important;
      }
      p {
        margin: 0;
      }
      a {
        color: #067df7;
        text-decoration: none;
      }
      .apple-invoice td {
        border-right: 1px solid #ffffff;
        border-bottom: 1px solid #ffffff;
      }
      .apple-invoice p {
        margin: 0;
        font-size: 12px;
        line-height: 1.4;
      }
      .apple-invoice p:first-child {
        font-size: 10px;
        line-height: 1.4;
        color: #666666;
        margin: 0;
      }
      .apple-invoice a {
        color: #1155cc;
        text-decoration: underline;
      }
      .community-rich-0 em:nth-of-type(1) {
        font-style: normal;
        vertical-align: super;
        font-size: smaller;
        font-weight: 300;
      }
      .community-rich-0 a:nth-of-type(1) {
        text-decoration: none;
      }
      .community-rich-0 em:nth-of-type(2) {
        font-style: normal;
        vertical-align: super;
        font-size: smaller;
        font-weight: 300;
      }
      .community-rich-3 a:nth-of-type(1) {
        font-size: 12px;
        color: #0070c9;
        text-decoration: none;
      }
      .community-rich-3 a:nth-of-type(2) {
        font-size: 12px;
        color: #0070c9;
        text-decoration: none;
      }
      .community-rich-3 em {
        margin: 0 4px;
        color: #333333;
        font-style: normal;
        font-weight: 200;
      }
      .community-rich-5 a:nth-of-type(1) {
        color: #007eff;
        text-decoration: none;
      }
      .community-rich-6 a:nth-of-type(1) {
        color: #0073ff;
        text-decoration: none;
      }
      .community-rich-7 a:nth-of-type(1) {
        color: #0073ff;
        text-decoration: none;
      }
      .community-rich-8 a:nth-of-type(1) {
        text-decoration: none;
      }
      .community-rich-9 a:nth-of-type(1) {
        text-decoration: none;
      }
      .community-rich-10 a:nth-of-type(1) {
        text-decoration: none;
      }
      .community-rich-10 a:nth-of-type(2) {
        text-decoration: none;
      }
      .community-rich-10 a:nth-of-type(3) {
        text-decoration: none;
      }
      .community-rich-13 a:nth-of-type(1) {
        text-decoration: none;
      }
      .apple-legal div,
      .community-rich-3 div {
        line-height: normal !important;
      }
      /* Preserve the source table's intrinsic label/divider/90px price layout. */
      .apple-total-row table {
        font-weight: 600;
        word-break: normal;
        border-collapse: separate;
        border-spacing: 0;
      }
      .apple-total-row td {
        vertical-align: middle;
      }
      .apple-total-row td:first-child p {
        padding-right: 30px;
        font-size: 10px;
        color: #666666;
      }
      .apple-total-row td:nth-child(2) {
        min-height: 48px;
        border-left: 1px solid #eeeeee;
      }
      .apple-total-row td:last-child p {
        margin-right: 20px;
        white-space: nowrap;
      }
      .apple-wallet-cta {
        width: auto !important;
        max-width: 100%;
      }
      .apple-wallet-icon {
        width: 36px !important;
        max-width: 36px;
      }
      .apple-wallet-label {
        width: auto !important;
        max-width: none;
      }
      .community-rich-5 div {
        line-height: normal !important;
      }
      @media only screen and (max-width: 479px) {
        .apple-item-icon {
          width: 20% !important;
        }
        .apple-item-icon img {
          height: auto !important;
        }
        .apple-item-description {
          width: 64% !important;
        }
        .apple-item-copy {
          padding: 0 12px !important;
        }
        .apple-item-price {
          width: 16% !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body width="660px" background-color="#ffffff">
    <mj-section padding="20px 0px 0px">
      <mj-group width="100%" css-class="apple-header-row">
        <mj-column padding="0px" width="50%" vertical-align="middle">
          <mj-image
            src="https://demo.react.email/static/apple-logo.png"
            alt="Apple Logo"
            width="42px"
            height="42px"
            align="left"
            padding="0px"
          />
        </mj-column>
        <mj-column padding="0px" width="50%" vertical-align="middle">
          <mj-text
            padding="16px 0px"
            font-size="32px"
            line-height="24px"
            font-weight="300"
            color="#888888"
            align="right"
            >Receipt</mj-text
          >
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-text
          padding="36px 0px 40px"
          font-size="14px"
          line-height="24px"
          font-weight="500"
          color="#111111"
          align="center"
          css-class="community-rich-0"
          >Save 3% on all your Apple purchases with Apple Card.<em>1</em>
          <a href="https://www.apple.com/apple-card/">Apply and use in minutes</a><em>2</em>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0px" background-color="#fafafa" border-radius="3px">
      <mj-column padding="0px">
        <mj-table
          font-size="12px"
          color="#333333"
          line-height="1.4"
          padding="0px"
          css-class="apple-invoice"
          ><tr>
            <td colspan="2" style="padding: 0px 0px 0px 20px">
              <p>APPLE ID</p>
              <p><a>alan.turing@gmail.com</a></p>
            </td>
            <td colspan="2" rowspan="3" style="padding: 0px 0px 0px 20px">
              <p>BILLED TO</p>
              <p>Visa .... 7461 (Apple Pay)</p>
              <p>Alan Turing</p>
              <p>2125 Chestnut St</p>
              <p>San Francisco, CA 94123</p>
              <p>USA</p>
            </td>
          </tr>
          <tr>
            <td colspan="2" style="padding: 0px 0px 0px 20px">
              <p>INVOICE DATE</p>
              <p>18 Jan 2023</p>
            </td>
          </tr>
          <tr>
            <td style="padding: 0px 0px 0px 20px">
              <p>ORDER ID</p>
              <p><a>ML4F5L8522</a></p>
            </td>
            <td style="padding: 0px 0px 0px 20px">
              <p>DOCUMENT NO.</p>
              <p>186623754793</p>
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>
    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-spacer height="30px" />
      </mj-column>
    </mj-section>
    <mj-section padding="0px" background-color="#fafafa" border-radius="3px">
      <mj-column padding="0px">
        <mj-text
          padding="0px 10px"
          font-size="14px"
          line-height="24px"
          font-weight="500"
          color="#333333"
          >App Store</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section padding="15px 20px 0px">
      <mj-group width="100%" css-class="apple-item-row">
        <mj-column padding="0px" width="66px" vertical-align="middle" css-class="apple-item-icon">
          <mj-image
            src="https://demo.react.email/static/apple-hbo-max-icon.jpeg"
            alt="HBO Max"
            width="64px"
            height="64px"
            align="left"
            padding="0px"
            border-radius="14px"
            border="1px solid #f2f2f2"
          />
        </mj-column>
        <mj-column
          padding="0px"
          width="454px"
          vertical-align="middle"
          css-class="apple-item-description"
        >
          <mj-text
            padding="0px 0px 0px 22px"
            font-size="12px"
            line-height="1.4"
            font-weight="600"
            css-class="apple-item-copy"
            >HBO Max: Stream TV &amp; Movies</mj-text
          >
          <mj-text
            padding="0px 0px 0px 22px"
            font-size="12px"
            line-height="1.4"
            color="#666666"
            css-class="apple-item-copy"
            >HBO Max Ad-Free (Monthly)<br />Renews Aug 20, 2023</mj-text
          >
          <mj-text
            padding="0px 0px 0px 22px"
            font-size="16px"
            line-height="1.5"
            css-class="apple-item-copy community-rich-3"
            ><a href="https://www.apple.com/">Write a Review</a><em>|</em
            ><a href="https://www.apple.com/">Report a Problem</a>
          </mj-text>
        </mj-column>
        <mj-column padding="0px" width="100px" css-class="apple-item-price">
          <mj-text padding="0px" font-size="12px" line-height="24px" font-weight="600" align="right"
            >$14.99</mj-text
          >
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-divider border-color="#eaeaea" border-width="1px" padding="30px 0px 0px" />
      </mj-column>
    </mj-section>
    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-table padding="0px" font-size="16px" line-height="24px" css-class="apple-total-row"
          ><tr>
            <td style="text-align: right"><p>TOTAL</p></td>
            <td style="padding: 48px 0px 0px"></td>
            <td style="width: 90px; text-align: right"><p>$14.99</p></td>
          </tr></mj-table
        >
      </mj-column>
    </mj-section>
    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-divider border-color="#eaeaea" border-width="1px" padding="0px 0px 75px" />
        <mj-image
          src="https://demo.react.email/static/apple-card-icon.png"
          alt="Apple Card"
          width="60px"
          height="17px"
          align="center"
          padding="0px"
        />
        <mj-text
          padding="16px 0px"
          font-size="24px"
          line-height="1"
          font-weight="500"
          align="center"
          >Save 3% on all your Apple purchases.</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section padding="0px">
      <mj-group width="220px" css-class="apple-wallet-cta">
        <mj-column padding="0px" width="36px" vertical-align="middle" css-class="apple-wallet-icon">
          <mj-image
            src="https://demo.react.email/static/apple-wallet.png"
            alt="Apple Wallet"
            width="28px"
            height="28px"
            align="right"
            padding="0px 8px 0px 0px"
            href="https://www.apple.com/"
          />
        </mj-column>
        <mj-column
          padding="0px"
          width="184px"
          vertical-align="middle"
          css-class="apple-wallet-label"
        >
          <mj-text padding="0px" font-size="14px" line-height="1.5" css-class="community-rich-5"
            ><a href="https://www.apple.com/">Apply and use in minutes</a>
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-divider border-color="#eaeaea" border-width="1px" padding="65px 0px 20px" />
        <mj-text
          padding="0px 0px 16px"
          font-size="12px"
          line-height="1.2"
          color="#666666"
          css-class="apple-legal"
          >1. 3% savings is earned as Daily Cash and is transferred to your Apple Cash card when
          transactions post to your Apple Card account. If you do not have an Apple Cash card, Daily
          Cash can be applied by you as a credit on your statement balance. 3% is the total amount
          of Daily Cash earned for these purchases. See the Apple Card Customer Agreement for more
          details on Daily Cash and qualifying transactions.</mj-text
        >
        <mj-text
          padding="0px 0px 16px"
          font-size="12px"
          line-height="1.2"
          color="#666666"
          css-class="apple-legal"
          >2. Subject to credit approval.</mj-text
        >
        <mj-text
          padding="0px 0px 16px"
          font-size="12px"
          line-height="1.2"
          color="#666666"
          css-class="apple-legal"
          >To access and use all the features of Apple Card, you must add Apple Card to Wallet on an
          iPhone or iPad with iOS or iPadOS 13.2 or later. Update to the latest version of iOS or
          iPadOS by going to Settings &gt; General &gt; Software Update. Tap Download and
          Install.</mj-text
        >
        <mj-text
          padding="0px 0px 16px"
          font-size="12px"
          line-height="1.2"
          color="#666666"
          css-class="apple-legal"
          >Available for qualifying applicants in the United States.</mj-text
        >
        <mj-text
          padding="0px 0px 16px"
          font-size="12px"
          line-height="1.2"
          color="#666666"
          css-class="apple-legal"
          >Apple Card is issued by Goldman Sachs Bank USA, Salt Lake City Branch.</mj-text
        >
        <mj-text
          padding="0px"
          font-size="12px"
          line-height="1.2"
          color="#666666"
          css-class="apple-legal"
          >If you reside in the US territories, please call Goldman Sachs at 877-255-5923 with
          questions about Apple Card.</mj-text
        >
        <mj-text
          padding="20px 0px 0px"
          font-size="12px"
          line-height="1.2"
          color="#666666"
          align="center"
          css-class="apple-legal community-rich-6"
          >Privacy: We use a <a href="https://www.apple.com/"> Subscriber ID </a>to provide reports
          to developers.</mj-text
        >
        <mj-text
          padding="20px 0px 0px"
          font-size="12px"
          line-height="1.2"
          color="#666666"
          align="center"
          css-class="apple-legal community-rich-7"
          >Get help with subscriptions and purchases.<a href="https://www.apple.com/"
            >Visit Apple Support.</a
          >
        </mj-text>
        <mj-text
          padding="20px 0px 0px"
          font-size="12px"
          line-height="1.2"
          color="#666666"
          align="center"
          css-class="apple-legal community-rich-8"
          >Learn how to <a href="https://www.apple.com/">manage your password preferences</a> for
          iTunes, Apple Books, and App Store purchases.</mj-text
        >
        <mj-text
          padding="20px 0px 0px"
          font-size="12px"
          line-height="1.2"
          color="#666666"
          align="center"
          css-class="apple-legal community-rich-9"
          >You have the option to stop receiving email receipts for your subscription renewals. If
          you have opted out, you can still view your receipts in your account under Purchase
          History. To manage receipts or to opt in again, go to
          <a href="https://www.apple.com/">Account Settings.</a>
        </mj-text>
        <mj-image
          src="https://demo.react.email/static/apple-logo.png"
          alt="Apple Card"
          width="26px"
          height="26px"
          align="center"
          padding="60px 0px 0px"
        />
        <mj-text
          padding="8px 0px 0px"
          font-size="12px"
          line-height="24px"
          color="#666666"
          align="center"
          css-class="community-rich-10"
          ><a href="https://www.apple.com/">Account Settings</a> •
          <a href="https://www.apple.com/">Terms of Sale</a> •
          <a href="https://www.apple.com/legal/privacy/">Privacy Policy </a>
        </mj-text>
        <mj-text
          padding="25px 0px 48px"
          font-size="12px"
          line-height="24px"
          color="#666666"
          align="center"
          css-class="community-rich-13"
          >Copyright © 2023 Apple Inc.<br />
          <a href="https://www.apple.com/legal/">All rights reserved</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
