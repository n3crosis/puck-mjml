<!--
  Adapted from React Email (MIT, Copyright 2024 Plus Five Five, Inc).
  https://github.com/resend/react-email/blob/674d8ec2804b86be5d99156383fb1810179847bf/apps/demo/emails/02-Matte/subscription-update.tsx
  Canonical editable MJML source. See ../README.md and ../../THIRD_PARTY_NOTICES.md.
-->
<mjml lang="en" dir="ltr" owa="none">
  <mj-head>
    <mj-title> Your Collage plan renewed (Pro) </mj-title>
    <mj-preview> Your Collage plan renewed (Pro) </mj-preview>
    <mj-breakpoint width="601px" />
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&amp;display=swap"
    />
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
    </mj-attributes>
    <mj-style inline="inline">
      .pm-email-text p {
        margin: 0;
      }
      .pm-email-text h1,
      .pm-email-text h2,
      .pm-email-text h3,
      .pm-email-text h4,
      .pm-email-text h5,
      .pm-email-text h6 {
        margin: 0 0 0.5em;
        font-weight: bold;
      }
      .pm-email-text h1 {
        font-size: 1.7em;
        line-height: 1.15;
      }
      .pm-email-text h2 {
        font-size: 1.3em;
        line-height: 1.2;
      }
      .pm-email-text h3 {
        font-size: 1.17em;
        line-height: inherit;
      }
      .pm-email-text h4 {
        font-size: 1em;
        line-height: inherit;
      }
      .pm-email-text h5 {
        font-size: 0.83em;
        line-height: inherit;
      }
      .pm-email-text h6 {
        font-size: 0.67em;
        line-height: inherit;
      }
      .pm-email-text h1:last-child,
      .pm-email-text h2:last-child,
      .pm-email-text h3:last-child,
      .pm-email-text h4:last-child,
      .pm-email-text h5:last-child,
      .pm-email-text h6:last-child {
        margin-bottom: 0;
      }
    </mj-style>
    <mj-style inline="inline">
      body {
        padding: 0 16px !important;
      }
      .collage-card {
        box-shadow:
          0px 76px 21px 0px rgba(193, 195, 193, 0),
          0px 49px 19px 0px rgba(193, 195, 193, 0.01),
          0px 27px 16px 0px rgba(193, 195, 193, 0.05),
          0px 12px 12px 0px rgba(193, 195, 193, 0.09),
          0px 3px 7px 0px rgba(193, 195, 193, 0.1);
      }
      .collage-card a {
        color: inherit;
        text-decoration: none;
      }
      .collage-footer-copy > div {
        max-width: 320px;
      }
      .collage-unsubscribe > div {
        max-width: 169px;
      }
      .collage-renew-copy > div {
        max-width: 480px;
      }
    </mj-style>
    <mj-style>
      @media only screen and (max-width: 600px) {
        .collage-renew-logo > table > tbody > tr > td {
          padding: 64px 24px 0px !important;
        }
        .collage-renew-main > table > tbody > tr > td {
          padding: 32px 24px 0px !important;
        }
        .collage-renew-cta > table > tbody > tr > td {
          padding: 48px 24px 56px !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body width="608px" background-color="#FBFCFB">
    <mj-section background-color="#FBFCFB" padding="0px" border-radius="0px">
      <mj-column>
        <mj-spacer height="64px" />
      </mj-column>
    </mj-section>
    <mj-wrapper
      background-color="#FFFFFF"
      padding="0px"
      border="1px solid #D8E1D4"
      border-radius="8px"
      css-class="collage-card"
    >
      <mj-section
        background-color="#ffffff"
        padding="64px 40px 0px"
        border-radius="0px"
        css-class="collage-renew-logo"
      >
        <mj-column>
          <mj-image
            src="https://demo.react.email/static/collage/collage-image-2.png"
            width="148px"
            height="111px"
            align="left"
            padding="0px"
            border-radius="0px"
          />
        </mj-column>
      </mj-section>
      <mj-section
        background-color="#ffffff"
        padding="32px 40px 0px"
        border-radius="0px"
        css-class="collage-renew-main"
      >
        <mj-column>
          <mj-text
            color="#103B05"
            font-size="48px"
            font-family="Arial, Helvetica, sans-serif"
            font-weight="400"
            line-height="1"
            letter-spacing="-1.44px"
            align="left"
            padding="0px"
            css-class="pm-email-text collage-renew-copy"
          >
            <p>Plan renewed</p>
          </mj-text>
          <mj-text
            color="#194A07"
            font-size="14px"
            font-family="Inter, Arial, sans-serif"
            font-weight="400"
            line-height="1.5"
            letter-spacing="0px"
            align="left"
            padding="18px 0px 0px"
            css-class="pm-email-text collage-renew-copy"
          >
            <p>
              Hi Alex. Your Collage subscription renewed for another month. Here's a quick summary
              of your plan and billing.
            </p>
          </mj-text>
          <mj-text
            color="#194A07"
            font-size="14px"
            font-family="Inter, Arial, sans-serif"
            font-weight="400"
            line-height="1.5"
            letter-spacing="0px"
            align="left"
            padding="18px 0px 0px"
            css-class="pm-email-text collage-renew-copy"
          >
            <p>
              You're on the Pro plan at $29 per month. Your next charge is on April 22, 2026. Review
              invoices, update payment details, or change plans anytime in your account.
            </p>
          </mj-text>
          <mj-text
            color="#194A07"
            font-size="14px"
            font-family="Inter, Arial, sans-serif"
            font-weight="400"
            line-height="1.5"
            letter-spacing="0px"
            align="left"
            padding="18px 0px 0px"
            css-class="pm-email-text collage-renew-copy"
          >
            <p>Something look off? Reply to this email and we'll help sort it out.</p>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section
        background-color="#ffffff"
        padding="48px 40px 56px"
        border-radius="0px"
        css-class="collage-renew-cta"
      >
        <mj-column>
          <mj-button
            href="https://example.com/"
            background-color="#103B05"
            color="#FBFFF9"
            font-size="15px"
            font-family="Inter, Arial, sans-serif"
            font-weight="500"
            line-height="1.5"
            letter-spacing="-0.075px"
            inner-padding="14px 20px"
            border-radius="0px"
            align="left"
            padding="0px"
          >
            Manage subscription
          </mj-button>
        </mj-column>
      </mj-section>
      <mj-section background-color="#ffffff" padding="0px" border-radius="0px">
        <mj-column>
          <mj-divider border-color="#D8E1D4" border-width="1px" width="100%" padding="0px" />
        </mj-column>
      </mj-section>
      <mj-section
        background-color="#ffffff"
        padding="64px 40px"
        border-radius="0px 0px 7px 7px"
        css-class="collage-footer"
      >
        <mj-column>
          <mj-text
            color="#869C7F"
            font-size="13px"
            font-family="Inter, Arial, sans-serif"
            font-weight="300"
            line-height="1.5"
            letter-spacing="-0.039px"
            align="left"
            padding="0px"
            css-class="pm-email-text collage-footer-copy"
          >
            <p>
              Collage is the workspace where your team keeps projects, context, and updates
              together—from first idea to launch.
            </p>
          </mj-text>
          <mj-social
            align="left"
            padding="32px 0px 0px"
            icon-size="20px"
            icon-padding="0px"
            border-radius="0px"
          >
            <mj-social-element
              name="x-noshare"
              href="https://example.com/"
              src="https://demo.react.email/static/shared/social-x-black.png"
              alt="X"
              background-color="transparent"
              padding="0px 32px 0px 0px"
            >
            </mj-social-element>
            <mj-social-element
              name="linkedin-noshare"
              href="https://example.com/"
              src="https://demo.react.email/static/shared/social-in-black.png"
              alt="LinkedIn"
              background-color="transparent"
              padding="0px 32px 0px 0px"
            >
            </mj-social-element>
            <mj-social-element
              name="youtube"
              href="https://example.com/"
              src="https://demo.react.email/static/shared/social-yt-black.png"
              alt="YouTube"
              background-color="transparent"
              padding="0px 32px 0px 0px"
            >
            </mj-social-element>
            <mj-social-element
              name="github"
              href="https://example.com/"
              src="https://demo.react.email/static/shared/social-gh-black.png"
              alt="GitHub"
              background-color="transparent"
              padding="0px"
            >
            </mj-social-element>
          </mj-social>
          <mj-text
            color="#194A07"
            font-size="11px"
            font-family="Inter, Arial, sans-serif"
            font-weight="300"
            line-height="1.5"
            letter-spacing="-0.033px"
            align="left"
            padding="32px 0px 0px"
            css-class="pm-email-text"
          >
            <p>123 Market Street, Floor 1<br />Tech City, CA, 94102</p>
          </mj-text>
          <mj-text
            color="#194A07"
            font-size="11px"
            font-family="Inter, Arial, sans-serif"
            font-weight="300"
            line-height="1.5"
            letter-spacing="-0.033px"
            align="left"
            padding="20px 0px 0px"
            css-class="pm-email-text collage-unsubscribe"
          >
            <a href="https://example.com/">Unsubscribe</a> from Collage marketing emails.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section background-color="#FBFCFB" padding="0px" border-radius="0px">
      <mj-column>
        <mj-spacer height="24px" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
