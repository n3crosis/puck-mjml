<!--
  Adapted from React Email (MIT, Copyright 2024 Plus Five Five, Inc).
  https://github.com/resend/react-email/blob/674d8ec2804b86be5d99156383fb1810179847bf/apps/demo/emails/05-Studio/promo.tsx
  Canonical editable MJML source. See ../README.md and ../../THIRD_PARTY_NOTICES.md.
-->
<mjml lang="en" dir="ltr" owa="none">
  <mj-head>
    <mj-title>Your Halo promo code</mj-title>
    <mj-preview>Your Halo promo code</mj-preview>
    <mj-breakpoint width="601px" />
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;600&amp;display=swap"
    />
    <mj-font
      name="Geist"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;450;500;600;700&amp;display=swap"
    />
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
    </mj-attributes>
    <mj-style inline="inline">
      .studio-email a {
        color: inherit;
        text-decoration: none;
      }
      .studio-headline > div {
        max-width: 440px;
        margin: 0 auto;
      }
      .studio-footer-copy > div {
        max-width: 320px;
        margin: 0 auto;
      }
      .studio-benefit > div {
        max-width: 120px;
        margin: 0 auto;
      }
    </mj-style>
    <mj-style>
      @media only screen and (max-width: 600px) {
        .studio-mobile-inset > table > tbody > tr > td {
          padding-left: 24px !important;
          padding-right: 24px !important;
        }
        .studio-mobile-card > table > tbody > tr > td {
          padding-left: 24px !important;
          padding-right: 24px !important;
        }
        .studio-benefit > div {
          margin-bottom: 24px !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body width="640px" background-color="#F6F6F6" css-class="studio-email">
    <mj-section padding="16px 8px" background-color="#332C2C">
      <mj-column padding="0px" vertical-align="top">
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="14px"
          font-weight="450"
          line-height="1.6"
          letter-spacing="-0.042px"
          color="#DCE1E4"
          padding="0px"
          align="center"
          >Black Friday Sale: Save up to $80 on Halo</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section padding="40px 24px 32px" background-color="#E8E8E8">
      <mj-column padding="0px" vertical-align="top">
        <mj-image
          src="https://demo.react.email/static/tech/logo-wordmark.png"
          width="64px"
          alt="Halo logo"
          padding="0px"
          align="center"
        />
      </mj-column>
    </mj-section>
    <mj-section padding="0px 24px 80px" background-color="#E8E8E8">
      <mj-column padding="0px" vertical-align="top">
        <mj-text
          font-family="Geist, Inter, Arial, sans-serif"
          font-size="48px"
          font-weight="700"
          line-height="1.15"
          letter-spacing="-0.96px"
          color="#332C2C"
          padding="0px"
          align="center"
          css-class="studio-headline"
          >Save on the ring that keeps you clear</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section padding="0px" background-color="#E8E8E8">
      <mj-column padding="0px" vertical-align="top">
        <mj-image
          src="https://demo.react.email/static/tech/tech-image-5.png"
          width="640px"
          alt="Halo ring"
          padding="0px"
          align="center"
        />
      </mj-column>
    </mj-section>
    <mj-section padding="40px 24px 0px" background-color="#FFFFFF">
      <mj-column padding="0px" vertical-align="top">
        <mj-button
          href="https://example.com/"
          background-color="#FFFFFF"
          color="#332C2C"
          font-family="Inter, Arial, sans-serif"
          font-size="15px"
          font-weight="500"
          line-height="1.6"
          letter-spacing="-0.042px"
          border="1px solid #E8E9E9"
          border-radius="8px"
          inner-padding="12px 20px"
          padding="0px"
          align="center"
          >Save up to $80</mj-button
        >
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="11px"
          font-weight="400"
          line-height="1.5"
          letter-spacing="-0.11px"
          color="#726A6A"
          padding="16px 0px 0px"
          align="center"
          >Limited time only</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section padding="0px" background-color="#FFFFFF">
      <mj-column padding="0px" vertical-align="top">
        <mj-image
          src="https://demo.react.email/static/tech/tech-image-6.png"
          width="640px"
          alt="Halo ring"
          padding="0px"
          align="center"
        />
      </mj-column>
    </mj-section>
    <mj-section padding="72px 32px 0px" background-color="#F6F6F6" css-class="studio-mobile-inset">
      <mj-column
        padding="80px 48px"
        vertical-align="top"
        background-color="#F0F0F0"
        border-radius="10px"
        css-class="studio-mobile-card"
      >
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="20px"
          font-weight="400"
          line-height="1.5"
          letter-spacing="-0.1px"
          color="#726A6A"
          padding="0px"
          align="center"
          >★★★★★</mj-text
        >
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="22px"
          font-weight="500"
          line-height="1.4"
          letter-spacing="-0.176px"
          color="#332C2C"
          padding="20px 0px 0px"
          align="center"
          >“It's wild how fast Halo on my finger felt like calm help whenever my head was full and
          my hands were busy.”</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section padding="48px 56px 0px" background-color="#F6F6F6" css-class="studio-mobile-inset">
      <mj-column width="33.333333%" padding="0px 4px" vertical-align="top">
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="15px"
          font-weight="500"
          line-height="1.6"
          letter-spacing="-0.042px"
          color="#332C2C"
          padding="0px"
          align="center"
          css-class="studio-benefit"
          >Try your ring risk-free 30 days</mj-text
        >
      </mj-column>
      <mj-column width="33.333333%" padding="0px 4px" vertical-align="top">
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="15px"
          font-weight="500"
          line-height="1.6"
          letter-spacing="-0.042px"
          color="#332C2C"
          padding="0px"
          align="center"
          css-class="studio-benefit"
          >Free shipping and easy returns</mj-text
        >
      </mj-column>
      <mj-column width="33.333333%" padding="0px 4px" vertical-align="top">
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="15px"
          font-weight="500"
          line-height="1.6"
          letter-spacing="-0.042px"
          color="#332C2C"
          padding="0px"
          align="center"
          css-class="studio-benefit"
          >Two-year ring warranty included</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section padding="128px 24px 48px" background-color="#F6F6F6">
      <mj-column padding="0px" vertical-align="top">
        <mj-button
          href="https://example.com/"
          background-color="#FFFFFF"
          color="#332C2C"
          font-family="Inter, Arial, sans-serif"
          font-size="15px"
          font-weight="500"
          line-height="1.6"
          letter-spacing="-0.042px"
          border="1px solid #E8E9E9"
          border-radius="8px"
          inner-padding="12px 20px"
          padding="0px"
          align="center"
          >Shop Black Friday Sale</mj-button
        >
      </mj-column>
    </mj-section>
    <mj-section padding="80px 24px" background-color="#F6F6F6">
      <mj-column padding="0px" vertical-align="top">
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="13px"
          font-weight="400"
          line-height="1.5"
          letter-spacing="-0.13px"
          color="#726A6A"
          padding="0px"
          align="center"
          css-class="studio-footer-copy"
          >Halo is the AI ring on your finger—easy shopping, clear shipping, and real support when
          you need it.</mj-text
        >
        <mj-social
          align="center"
          padding="32px 0px"
          icon-size="20px"
          icon-padding="0px"
          border-radius="0px"
        >
          <mj-social-element
            name="x-noshare"
            href="https://example.com/"
            src="https://demo.react.email/static/shared/social-x-black.png"
            alt="X"
            background-color="transparent"
            padding="0px 32px 0px 0px"
          />
          <mj-social-element
            name="linkedin-noshare"
            href="https://example.com/"
            src="https://demo.react.email/static/shared/social-in-black.png"
            alt="LinkedIn"
            background-color="transparent"
            padding="0px 32px 0px 0px"
          />
          <mj-social-element
            name="youtube"
            href="https://example.com/"
            src="https://demo.react.email/static/shared/social-yt-black.png"
            alt="YouTube"
            background-color="transparent"
            padding="0px 32px 0px 0px"
          />
          <mj-social-element
            name="github"
            href="https://example.com/"
            src="https://demo.react.email/static/shared/social-gh-black.png"
            alt="GitHub"
            background-color="transparent"
            padding="0px"
          />
        </mj-social>
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="11px"
          font-weight="400"
          line-height="1.5"
          letter-spacing="-0.11px"
          color="#726A6A"
          padding="0px"
          align="center"
          >123 Market Street, Floor 1<br />Tech City, CA, 94102</mj-text
        >
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="11px"
          font-weight="400"
          line-height="1.5"
          letter-spacing="-0.11px"
          color="#726A6A"
          padding="20px 0px 0px"
          align="center"
        >
          <a href="https://example.com/">Unsubscribe</a> from Halo marketing emails.</mj-text
        >
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
