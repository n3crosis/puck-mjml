Public upstream PreviewProps only. See THIRD_PARTY_NOTICES.md for the MIT license. -->
<mjml>
  <mj-head>
    <mj-title>A fine-grained personal access token has been added to your account</mj-title>
    <mj-preview>A fine-grained personal access token has been added to your account</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="-apple-system,BlinkMacSystemFont,&#x27;Segoe UI&#x27;,Helvetica,Arial,sans-serif,&#x27;Apple Color Emoji&#x27;,&#x27;Segoe UI Emoji&#x27;"
      />
      <mj-text padding="0px" color="#24292e" />
    </mj-attributes>
    <mj-style>
      body {
        padding: 8px !important;
      }
      p {
        margin: 0;
      }
      a {
        color: inherit;
      }
    </mj-style>
    <mj-style inline="inline">
      .github-token-note a {
        color: #067df7;
        text-decoration: none;
      }
      .github-security-links a {
        font-size: 12px;
        color: #0366d6;
        text-decoration: none;
      }
    </mj-style>
  </mj-head>
  <mj-body width="480px" background-color="#ffffff">
    <mj-section padding="20px 0px 0px">
      <mj-column padding="0px">
        <mj-image
          src="https://demo.react.email/static/github.png"
          alt="Github"
          width="32px"
          height="32px"
          align="left"
          padding="0px"
        />
        <mj-text padding="16px 0px" font-size="24px" line-height="1.25"
          ><strong>@alanturing</strong>, a personal access was created on your account.</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section padding="24px" border="1px solid #dedede" border-radius="5px">
      <mj-column padding="0px">
        <mj-text padding="0px 0px 10px" font-size="14px" line-height="24px"
          >Hey <strong>alanturing</strong>!</mj-text
        >
        <mj-text
          padding="0px 0px 10px"
          font-size="14px"
          line-height="24px"
          css-class="github-token-note"
          >A fine-grained personal access token (<a>resend</a>) was recently added to your
          account.</mj-text
        >
        <mj-button
          align="center"
          padding="0px"
          inner-padding="12px 24px"
          border-radius="8px"
          font-size="14px"
          background-color="#28a745"
          color="#ffffff"
          >View your token</mj-button
        >
      </mj-column>
    </mj-section>
    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-text
          padding="16px 0px"
          font-size="14px"
          line-height="24px"
          align="center"
          css-class="github-security-links"
          ><a>Your security audit log</a> ・ <a>Contact support</a></mj-text
        >
        <mj-text
          padding="44px 0px 64px"
          font-size="12px"
          line-height="24px"
          align="center"
          color="#6a737d"
          >GitHub, Inc. ・88 Colin P Kelly Jr Street ・San Francisco, CA 94107</mj-text
        >
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
