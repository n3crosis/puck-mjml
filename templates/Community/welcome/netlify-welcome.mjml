Source: https://github.com/resend/react-email/blob/674d8ec2804b86be5d99156383fb1810179847bf/apps/demo/emails/Community/welcome/netlify-welcome.tsx
Public upstream PreviewProps only. See THIRD_PARTY_NOTICES.md for the MIT license. -->
<mjml>
  <mj-head>
    <mj-title>Netlify Welcome</mj-title>
    <mj-preview>Netlify Welcome</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="ui-sans-serif,system-ui,sans-serif,&#x27;Apple Color Emoji&#x27;,&#x27;Segoe UI Emoji&#x27;,&#x27;Segoe UI Symbol&#x27;,&#x27;Noto Color Emoji&#x27;"
      />
      <mj-text padding="0px" />
    </mj-attributes>
    <mj-style inline="inline">
      .community-rich-0 a,
      .netlify-footer-links a {
        color: #067df7;
        text-decoration: none;
      }
      .community-rich-0 ul {
        margin: 16px 0 !important;
        padding-left: 40px;
      }
      .netlify-resource-links a {
        color: #000000;
        text-decoration: underline;
        font-weight: 700;
      }
      .netlify-resource-links em {
        font-style: normal;
        color: #00c950;
      }
    </mj-style>
    <mj-style>
      body {
        padding: 8px !important;
      }
      p {
        margin: 0;
      }
      a {
        color: inherit;
      }
      .netlify-resource-links td,
      .netlify-resource-links td *,
      .netlify-footer-links td,
      .netlify-footer-links td * {
        overflow-wrap: normal;
      }
      .community-rich-0 li:nth-of-type(1) {
        margin-bottom: 20px;
      }
      .community-rich-0 li:nth-of-type(2) {
        margin-bottom: 20px;
      }
      .community-rich-0 li:nth-of-type(3) {
        margin-bottom: 20px;
      }
      .community-rich-0 li:nth-of-type(4) {
        margin-bottom: 20px;
      }
    </mj-style>
    <mj-style inline="inline">
      .reference-heading h1,
      .reference-heading h2 {
        margin: 0;
        font-family: inherit;
        font-size: inherit;
        font-weight: inherit;
        line-height: inherit;
        letter-spacing: inherit;
        color: inherit;
        text-transform: inherit;
      }
    </mj-style>
  </mj-head>
  <mj-body width="600px" background-color="#fafbfb">
    <mj-section padding="20px 0px">
      <mj-column padding="0px">
        <mj-image
          src="https://demo.react.email/static/netlify-logo.png"
          alt="Netlify"
          width="184px"
          height="75px"
          align="center"
          padding="0px"
        />
      </mj-column>
    </mj-section>
    <mj-section padding="45px 45px 0px" background-color="#ffffff">
      <mj-column padding="0px">
        <mj-text
          padding="0px 0px 16px"
          font-size="32px"
          line-height="32px"
          font-weight="700"
          align="center"
          css-class="reference-heading"
          ><h1>Welcome to Netlify</h1></mj-text
        >
        <mj-text padding="0px 0px 16px" font-size="16px" line-height="1.5"
          >Congratulations! You're joining over 3 million developers around the world who use
          Netlify to build and ship sites, stores, and apps.</mj-text
        >
        <mj-text padding="0px 0px 16px" font-size="16px" line-height="1.5"
          >Here's how to get started:</mj-text
        >
        <mj-text padding="0px" font-size="16px" line-height="1.5" css-class="community-rich-0"
          ><ul>
            <li>
              <strong>Deploy your first project.</strong> <a>Connect to Git, choose a template</a>,
              or manually deploy a project you've been working on locally.
            </li>
            <li>
              <strong>Check your deploy logs.</strong> Find out what's included in your build and
              watch for errors or failed deploys. <a>Learn how to read your deploy logs</a>.
            </li>
            <li>
              <strong>Choose an integration.</strong> Quickly discover, connect, and configure the
              right tools for your project with 150+ integrations to choose from.
              <a>Explore the Integrations Hub</a>.
            </li>
            <li>
              <strong>Set up a custom domain.</strong> You can register a new domain and buy it
              through Netlify or assign a domain you already own to your site.
              <a>Add a custom domain</a>.
            </li>
          </ul>
        </mj-text>
        <mj-button
          align="center"
          padding="0px"
          inner-padding="12px 18px"
          border-radius="8px"
          font-size="16px"
          background-color="#2250f4"
          color="#ffffff"
          >Go to your dashboard</mj-button
        >
      </mj-column>
    </mj-section>
    <mj-section padding="45px" background-color="#ffffff">
      <mj-column padding="0px">
        <mj-table
          padding="0px"
          width="100%"
          table-layout="auto"
          cellpadding="0"
          cellspacing="0"
          font-size="16px"
          line-height="24px"
          css-class="netlify-resource-links"
        >
          <tr>
            <td><a href="https://www.netlify.com/">Visit the forums</a> <em>→</em></td>
            <td><a href="https://www.netlify.com/">Read the docs</a> <em>→</em></td>
            <td><a href="https://www.netlify.com/">Contact an expert</a> <em>→</em></td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>
    <mj-section padding="20px 0px 16px">
      <mj-column padding="0px">
        <mj-table
          padding="0px"
          width="100%"
          table-layout="auto"
          cellpadding="0"
          cellspacing="0"
          font-size="16px"
          line-height="24px"
          css-class="netlify-footer-links"
        >
          <tr>
            <td style="padding: 0px 20px; text-align: right"><a>Unsubscribe</a></td>
            <td style="text-align: left"><a>Manage Preferences</a></td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>
    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-text
          padding="0px 0px 45px"
          font-size="14px"
          line-height="24px"
          align="center"
          color="#99a1af"
          >Netlify, 44 Montgomery Street, Suite 300 San Francisco, CA</mj-text
        >
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
