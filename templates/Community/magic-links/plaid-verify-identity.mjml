Public upstream PreviewProps only. See THIRD_PARTY_NOTICES.md for the MIT license. -->
<mjml>
  <mj-head>
    <mj-title>Verify Your Identity</mj-title>
    <mj-preview>Verify Your Identity</mj-preview>
    <mj-attributes>
      <mj-all font-family="HelveticaNeue,Helvetica,Arial,sans-serif" />
      <mj-text padding="0px" />
    </mj-attributes>
    <mj-style>
      body {
        padding: 8px !important;
      }
      p {
        margin: 0;
      }
      a {
        color: inherit;
      }
      .plaid-card {
        /* The pinned reference shadow has invalid five-component rgb() colors and paints none. */
        box-shadow: none;
      }
      .community-rich-0 em:nth-of-type(1) {
        font-style: normal;
        display: block;
        background-color: rgba(0, 0, 0, 0.05);
        box-sizing: border-box;
        width: 280px;
        max-width: 100%;
        margin: 0 auto;
        border-radius: 4px;
        padding: 8px;
      }
      .community-rich-1 a:nth-of-type(1) {
        color: #444444;
        text-decoration: underline;
      }
    </mj-style>
    <mj-style inline="inline">
      .reference-heading h1,
      .reference-heading h2 {
        margin: 0;
        font-family: inherit;
        font-size: inherit;
        font-weight: inherit;
        line-height: inherit;
        letter-spacing: inherit;
        color: inherit;
        text-transform: inherit;
      }
    </mj-style>
  </mj-head>
  <mj-body width="360px" background-color="#ffffff">
    <mj-section
      padding="68px 0px 130px"
      background-color="#ffffff"
      border="1px solid #eeeeee"
      border-radius="4px"
      css-class="plaid-card"
    >
      <mj-column padding="0px">
        <mj-image
          src="https://demo.react.email/static/plaid-logo.png"
          alt="Plaid"
          width="212px"
          height="88px"
          align="center"
          padding="0px"
        />
        <mj-text
          padding="16px 8px 8px"
          font-size="11px"
          line-height="16px"
          color="#0a85ea"
          font-weight="700"
          align="center"
          text-transform="uppercase"
          >Verify Your Identity</mj-text
        >
        <mj-text
          padding="0px"
          font-size="20px"
          font-family="HelveticaNeue-Medium,Helvetica,Arial,sans-serif"
          line-height="24px"
          font-weight="500"
          align="center"
          css-class="reference-heading"
          ><h1>Enter the following code to finish linking Venmo.</h1></mj-text
        >
        <mj-text
          padding="16px 0px 14px"
          font-family="HelveticaNeue-Bold"
          font-size="32px"
          line-height="40px"
          font-weight="700"
          letter-spacing="6px"
          align="center"
          css-class="community-rich-0"
          ><em>144833</em>
        </mj-text>
        <mj-text
          padding="0px 40px"
          font-size="15px"
          line-height="23px"
          color="#444444"
          align="center"
          >Not expecting this email?</mj-text
        >
        <mj-text
          padding="0px 40px"
          font-size="15px"
          line-height="23px"
          color="#444444"
          align="center"
          css-class="community-rich-1"
          >Contact <a href="mailto:login@plaid.com">login@plaid.com</a> if you did not request this
          code.</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-text
          padding="20px 0px 0px"
          font-size="12px"
          line-height="23px"
          font-weight="800"
          align="center"
          text-transform="uppercase"
          >Securely powered by Plaid.</mj-text
        >
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
