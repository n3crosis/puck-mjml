  Canonical editable MJML source. See ../README.md and ../../THIRD_PARTY_NOTICES.md.
-->
<mjml lang="en" dir="ltr" owa="none">
  <mj-head>
    <mj-title>Your Halo ring cart is waiting</mj-title>
    <mj-preview>Your Halo ring cart is waiting</mj-preview>
    <mj-breakpoint width="601px" />
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;600&amp;display=swap"
    />
    <mj-font
      name="Geist"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;450;500;600;700&amp;display=swap"
    />
    <mj-style>
      /* Exact registrations from the pinned TechFonts component.
         Preserve the original Inter 400/450 mapping and Geist v4 face. */
      @font-face {
        font-family: "Geist";
        font-style: normal;
        font-weight: 400;
        mso-font-alt: "Arial";
        src: url(https://fonts.gstatic.com/s/geist/v4/gyByhwUxId8gMEwcGFU.woff2) format("woff2");
      }
      @font-face {
        font-family: "Geist";
        font-style: normal;
        font-weight: 450;
        mso-font-alt: "Arial";
        src: url(https://fonts.gstatic.com/s/geist/v4/gyByhwUxId8gMEwcGFU.woff2) format("woff2");
      }
      @font-face {
        font-family: "Geist";
        font-style: normal;
        font-weight: 500;
        mso-font-alt: "Arial";
        src: url(https://fonts.gstatic.com/s/geist/v4/gyByhwUxId8gMEwcGFU.woff2) format("woff2");
      }
      @font-face {
        font-family: "Geist";
        font-style: normal;
        font-weight: 600;
        mso-font-alt: "Arial";
        src: url(https://fonts.gstatic.com/s/geist/v4/gyByhwUxId8gMEwcGFU.woff2) format("woff2");
      }
      @font-face {
        font-family: "Geist";
        font-style: normal;
        font-weight: 700;
        mso-font-alt: "Arial";
        src: url(https://fonts.gstatic.com/s/geist/v4/gyByhwUxId8gMEwcGFU.woff2) format("woff2");
      }
      @font-face {
        font-family: "Inter";
        font-style: normal;
        font-weight: 400;
        mso-font-alt: "Arial";
        src: url(https://fonts.gstatic.com/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuOKfMZg.ttf)
          format("truetype");
      }
      @font-face {
        font-family: "Inter";
        font-style: normal;
        font-weight: 450;
        mso-font-alt: "Arial";
        src: url(https://fonts.gstatic.com/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuOKfMZg.ttf)
          format("truetype");
      }
      @font-face {
        font-family: "Inter";
        font-style: normal;
        font-weight: 500;
        mso-font-alt: "Arial";
        src: url(https://fonts.gstatic.com/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuI6fMZg.ttf)
          format("truetype");
      }
      @font-face {
        font-family: "Inter";
        font-style: normal;
        font-weight: 600;
        mso-font-alt: "Arial";
        src: url(https://fonts.gstatic.com/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuGKYMZg.ttf)
          format("truetype");
      }
    </mj-style>
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
    </mj-attributes>
    <mj-style inline="inline">
      .studio-email a {
        color: inherit;
        text-decoration: none;
      }
      .studio-wide-copy > div {
        max-width: 480px;
        margin: 0 auto;
      }
      .studio-footer-copy > div {
        max-width: 320px;
        margin: 0 auto;
      }
      .studio-benefit > div {
        max-width: 120px;
        margin: 0 auto;
      }
    </mj-style>
    <mj-style>
      @media only screen and (max-width: 600px) {
        .studio-review-section > table > tbody > tr > td {
          padding-left: 16px !important;
          padding-right: 16px !important;
        }
        .studio-product-image {
          width: 80px !important;
          max-width: 80px !important;
        }
        .studio-product-copy {
          width: calc(100% - 80px) !important;
          max-width: calc(100% - 80px) !important;
        }
        .studio-mobile-inset > table > tbody > tr > td {
          padding-left: 24px !important;
          padding-right: 24px !important;
        }
        .studio-mobile-card > table > tbody > tr > td {
          padding-left: 24px !important;
          padding-right: 24px !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body width="640px" background-color="#FFFFFF" css-class="studio-email">
    <mj-section padding="56px 24px 40px" background-color="#F6F6F6">
      <mj-column padding="0px" vertical-align="top">
        <mj-image
          src="https://demo.react.email/static/tech/logo-wordmark.png"
          width="64px"
          alt="Halo logo"
          padding="0px"
          align="center"
        />
      </mj-column>
    </mj-section>
    <mj-section padding="0px 48px 64px" background-color="#F6F6F6">
      <mj-column padding="0px" vertical-align="top">
        <mj-text
          font-family="Geist, Inter, Arial, sans-serif"
          font-size="40px"
          font-weight="700"
          line-height="1.2"
          letter-spacing="-0.8px"
          color="#332C2C"
          padding="0px"
          align="center"
          >Pick up where<br />you left off</mj-text
        >
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="14px"
          font-weight="450"
          line-height="1.6"
          letter-spacing="-0.042px"
          color="#726A6A"
          padding="20px 0px 0px"
          align="center"
          css-class="studio-wide-copy"
          >Your cart still holds your Halo ring—we saved your size and finish. Check out soon before
          inventory shifts or your hold window expires.</mj-text
        >
        <mj-button
          href="https://example.com/"
          background-color="#FFFFFF"
          color="#1F2222"
          font-family="Inter, Arial, sans-serif"
          font-size="15px"
          font-weight="500"
          line-height="1.2"
          letter-spacing="-0.042px"
          border="1px solid #E8E9E9"
          border-radius="8px"
          inner-padding="12px 20px"
          padding="32px 0px 0px"
          align="center"
          >Return to cart</mj-button
        >
      </mj-column>
    </mj-section>
    <mj-wrapper padding="0px 48px 24px" background-color="#F6F6F6" css-class="studio-product-wrap">
      <mj-section padding="8px" background-color="#F0F0F0" border-radius="16px">
        <mj-group width="100%">
          <mj-column
            width="80px"
            padding="0px"
            vertical-align="middle"
            css-class="studio-product-image"
          >
            <mj-image
              src="https://demo.react.email/static/tech/tech-image.png"
              width="80px"
              alt="Halo Ring 1"
              padding="0px"
              align="left"
              border-radius="12px"
            />
          </mj-column>
          <mj-column
            width="448px"
            padding="0px 0px 0px 16px"
            vertical-align="middle"
            css-class="studio-product-copy"
          >
            <mj-text
              font-family="Inter, Arial, sans-serif"
              font-size="15px"
              font-weight="500"
              line-height="1.6"
              letter-spacing="-0.042px"
              color="#332C2C"
              padding="0px"
              align="left"
              >Halo Ring 1</mj-text
            >
            <mj-text
              font-family="Inter, Arial, sans-serif"
              font-size="14px"
              font-weight="450"
              line-height="1.6"
              letter-spacing="-0.042px"
              color="#A2A9AA"
              padding="4px 0px 0px"
              align="left"
              >x1</mj-text
            >
          </mj-column>
        </mj-group>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="112px 32px 0px" background-color="#F6F6F6">
      <mj-column padding="0px" vertical-align="top">
        <mj-text
          font-family="Geist, Inter, Arial, sans-serif"
          font-size="24px"
          font-weight="600"
          line-height="1.4"
          letter-spacing="-0.12px"
          color="#332C2C"
          padding="0px"
          align="center"
          >Don't take it from us</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section
      padding="40px 32px 0px"
      background-color="#F6F6F6"
      css-class="studio-review-section"
    >
      <mj-column
        padding="80px 48px"
        vertical-align="top"
        background-color="#F0F0F0"
        border-radius="10px"
        css-class="studio-mobile-card"
      >
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="20px"
          font-weight="400"
          line-height="1.5"
          letter-spacing="-0.1px"
          color="#726A6A"
          padding="0px"
          align="center"
          >★★★★★</mj-text
        >
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="22px"
          font-weight="500"
          line-height="1.4"
          letter-spacing="-0.176px"
          color="#332C2C"
          padding="20px 0px 0px"
          align="center"
          >“It's wild how fast Halo on my finger felt like calm help whenever my head was full and
          my hands were busy.”</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section padding="48px 56px 0px" background-color="#F6F6F6" css-class="studio-mobile-inset">
      <mj-column width="33.333333%" padding="0px 4px" vertical-align="top">
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="15px"
          font-weight="500"
          line-height="1.6"
          letter-spacing="-0.042px"
          color="#332C2C"
          padding="0px"
          align="center"
          css-class="studio-benefit"
          >Try your ring risk-free 30 days</mj-text
        >
      </mj-column>
      <mj-column width="33.333333%" padding="0px 4px" vertical-align="top">
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="15px"
          font-weight="500"
          line-height="1.6"
          letter-spacing="-0.042px"
          color="#332C2C"
          padding="0px"
          align="center"
          css-class="studio-benefit"
          >Free shipping and easy returns</mj-text
        >
      </mj-column>
      <mj-column width="33.333333%" padding="0px 4px" vertical-align="top">
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="15px"
          font-weight="500"
          line-height="1.6"
          letter-spacing="-0.042px"
          color="#332C2C"
          padding="0px"
          align="center"
          css-class="studio-benefit"
          >Two-year ring warranty included</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section padding="40px 32px 80px" background-color="#F6F6F6">
      <mj-column padding="0px" vertical-align="top">
        <mj-button
          href="https://example.com/"
          background-color="#FFFFFF"
          color="#1F2222"
          font-family="Inter, Arial, sans-serif"
          font-size="15px"
          font-weight="500"
          line-height="1.2"
          letter-spacing="-0.042px"
          border="1px solid #E8E9E9"
          border-radius="8px"
          inner-padding="12px 20px"
          padding="0px"
          align="center"
          >Return to cart</mj-button
        >
      </mj-column>
    </mj-section>
    <mj-section padding="80px 24px" background-color="#FFFFFF">
      <mj-column padding="0px" vertical-align="top">
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="13px"
          font-weight="400"
          line-height="1.5"
          letter-spacing="-0.13px"
          color="#726A6A"
          padding="0px"
          align="center"
          css-class="studio-footer-copy"
          >Halo is the AI ring on your finger—easy shopping, clear shipping, and real support when
          you need it.</mj-text
        >
        <mj-social
          align="center"
          padding="32px 0px"
          icon-size="20px"
          icon-padding="0px"
          border-radius="0px"
        >
          <mj-social-element
            name="x-noshare"
            href="https://example.com/"
            src="https://demo.react.email/static/shared/social-x-black.png"
            alt="X"
            background-color="transparent"
            padding="0px 32px 0px 0px"
          />
          <mj-social-element
            name="linkedin-noshare"
            href="https://example.com/"
            src="https://demo.react.email/static/shared/social-in-black.png"
            alt="LinkedIn"
            background-color="transparent"
            padding="0px 32px 0px 0px"
          />
          <mj-social-element
            name="youtube"
            href="https://example.com/"
            src="https://demo.react.email/static/shared/social-yt-black.png"
            alt="YouTube"
            background-color="transparent"
            padding="0px 32px 0px 0px"
          />
          <mj-social-element
            name="github"
            href="https://example.com/"
            src="https://demo.react.email/static/shared/social-gh-black.png"
            alt="GitHub"
            background-color="transparent"
            padding="0px"
          />
        </mj-social>
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="11px"
          font-weight="400"
          line-height="1.5"
          letter-spacing="-0.11px"
          color="#726A6A"
          padding="0px"
          align="center"
          >123 Market Street, Floor 1<br />Tech City, CA, 94102</mj-text
        >
        <mj-text
          font-family="Inter, Arial, sans-serif"
          font-size="11px"
          font-weight="400"
          line-height="1.5"
          letter-spacing="-0.11px"
          color="#726A6A"
          padding="20px 0px 0px"
          align="center"
        >
          <a href="https://example.com/">Unsubscribe</a> from Halo marketing emails.</mj-text
        >
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
