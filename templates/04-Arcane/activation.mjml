<!--
  Adapted from React Email (MIT, Copyright 2024 Plus Five Five, Inc).
  https://github.com/resend/react-email/blob/674d8ec2804b86be5d99156383fb1810179847bf/apps/demo/emails/04-Arcane/activation.tsx
  Canonical editable MJML source. See ../README.md and ../../THIRD_PARTY_NOTICES.md.
-->
<mjml lang="en" dir="ltr" owa="none">
  <mj-head>
    <mj-title>Confirm your email address</mj-title>
    <mj-preview>Confirm your email address</mj-preview>
    <mj-breakpoint width="601px" />
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;600&amp;display=swap"
    />
    <mj-font
      name="Instrument Serif"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif&amp;display=swap"
    />
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
    </mj-attributes>
    <mj-style inline="inline">
      .arcane-email a {
        color: inherit;
        text-decoration: none;
      }
      .arcane-unsubscribe a {
        color: #efe1d8;
      }
      .arcane-narrow > div {
        max-width: 480px;
      }
      .arcane-footer-copy > div {
        max-width: 320px;
      }
      .arcane-unsubscribe > div {
        max-width: 169px;
      }
      .arcane-note > div {
        max-width: 310px;
      }
    </mj-style>
    <mj-style>
      @media only screen and (max-width: 600px) {
        .arcane-inset > table > tbody > tr > td {
          padding-left: 24px !important;
          padding-right: 24px !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body width="640px" background-color="#FFFFFF" css-class="arcane-email">
    <mj-wrapper padding="0px" background-color="#300610">
      <mj-section padding="40px 40px 24px" css-class="arcane-inset">
        <mj-column padding="0px" vertical-align="top">
          <mj-image
            src="https://demo.react.email/static/shared/logo-white.png"
            width="32px"
            height="32px"
            alt=""
            padding="0px"
            align="left"
          />
        </mj-column>
      </mj-section>
      <mj-section padding="0px 16px">
        <mj-column padding="0px" vertical-align="top">
          <mj-image
            src="https://demo.react.email/static/skin/skin-image-1.png"
            width="608px"
            alt=""
            padding="0px"
            align="left"
          />
        </mj-column>
      </mj-section>
      <mj-section padding="80px 40px" css-class="arcane-inset">
        <mj-column padding="0px" vertical-align="top">
          <mj-text
            font-family="Instrument Serif, Georgia, Times New Roman, serif"
            font-size="72px"
            font-weight="400"
            line-height="1"
            letter-spacing="-0.52px"
            color="#FCF3ED"
            padding="16px 0px 0px"
            align="left"
            css-class="arcane-narrow"
            >Almost there</mj-text
          >
          <mj-text
            font-family="Inter, Arial, sans-serif"
            font-size="15px"
            font-weight="400"
            line-height="1.5"
            letter-spacing="0.25px"
            color="#EFE1D8"
            padding="32px 0px 0px"
            align="left"
            >Thank you for signing up for Skin.</mj-text
          >
          <mj-text
            font-family="Inter, Arial, sans-serif"
            font-size="15px"
            font-weight="400"
            line-height="1.5"
            letter-spacing="0.25px"
            color="#EFE1D8"
            padding="0px"
            align="left"
            >To verify your account, we just need to confirm your email.</mj-text
          >
          <mj-text
            font-family="Inter, Arial, sans-serif"
            font-size="16px"
            font-weight="500"
            line-height="1.5"
            letter-spacing="0.168px"
            color="#FCF3ED"
            padding="36px 0px 0px"
            align="left"
          >
            <a href="https://example.com/">Confirm email →</a>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="16px 40px" css-class="arcane-inset">
        <mj-column padding="0px" vertical-align="top">
          <mj-text
            font-family="Inter, Arial, sans-serif"
            font-size="11px"
            font-weight="400"
            line-height="1.5"
            letter-spacing="0.3px"
            color="#B09996"
            padding="0px"
            align="left"
            css-class="arcane-note"
            >If you didn't create an account with Skin, you can ignore this email—your inbox won't
            be added to our list.</mj-text
          >
        </mj-column>
      </mj-section>
      <mj-section padding="0px">
        <mj-column padding="0px" vertical-align="top">
          <mj-spacer height="48px" padding="0px" />
        </mj-column>
      </mj-section>
      <mj-section padding="80px 40px 64px" css-class="arcane-inset" border-top="1px solid #3D151D">
        <mj-column padding="0px" vertical-align="top">
          <mj-text
            font-family="Inter, Arial, sans-serif"
            font-size="13px"
            font-weight="400"
            line-height="1.5"
            letter-spacing="0.2px"
            color="#B09996"
            padding="0px"
            align="left"
            css-class="arcane-footer-copy"
            >Skin crafts thoughtful skincare—barrier-first formulas, honest labels, and routines
            you'll actually keep.</mj-text
          >
          <mj-social
            align="left"
            padding="32px 0px 0px"
            icon-size="20px"
            icon-padding="0px"
            border-radius="0px"
          >
            <mj-social-element
              name="x-noshare"
              href="https://example.com/"
              src="https://demo.react.email/static/skin/social-x.png"
              alt="X"
              background-color="transparent"
              padding="0px 24px 0px 0px"
            />
            <mj-social-element
              name="linkedin-noshare"
              href="https://example.com/"
              src="https://demo.react.email/static/skin/social-li.png"
              alt="LinkedIn"
              background-color="transparent"
              padding="0px 24px 0px 0px"
            />
            <mj-social-element
              name="youtube"
              href="https://example.com/"
              src="https://demo.react.email/static/skin/social-yt.png"
              alt="YouTube"
              background-color="transparent"
              padding="0px 24px 0px 0px"
            />
            <mj-social-element
              name="github"
              href="https://example.com/"
              src="https://demo.react.email/static/skin/social-gh.png"
              alt="GitHub"
              background-color="transparent"
              padding="0px"
            />
          </mj-social>
          <mj-text
            font-family="Inter, Arial, sans-serif"
            font-size="11px"
            font-weight="400"
            line-height="1.5"
            letter-spacing="0.3px"
            color="#B09996"
            padding="32px 0px 0px"
            align="left"
            >124 Mercantile Row, Studio 3<br />Los Angeles, CA, 90013</mj-text
          >
          <mj-text
            font-family="Inter, Arial, sans-serif"
            font-size="11px"
            font-weight="400"
            line-height="1.5"
            letter-spacing="0.3px"
            color="#B09996"
            padding="20px 0px 0px"
            align="left"
            css-class="arcane-unsubscribe"
          >
            <a href="https://example.com/">Unsubscribe</a> from Skin marketing emails.</mj-text
          >
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
