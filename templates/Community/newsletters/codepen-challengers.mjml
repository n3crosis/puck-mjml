<mjml>
  <mj-head>
    <mj-title>#CodePenChallenge: Cubes</mj-title>
    <mj-preview>#CodePenChallenge: Cubes</mj-preview>
    <mj-attributes>
      <mj-all font-family="Google Sans,Roboto,RobotoDraft,Helvetica,Arial,sans-serif" />
      <mj-text padding="0px" />
    </mj-attributes>
    <mj-style>
      p {
        margin: 0;
