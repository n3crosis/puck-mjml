Public upstream PreviewProps only. See THIRD_PARTY_NOTICES.md for the MIT license. -->
<mjml>
  <mj-head>
    <mj-title>Log in with this magic link</mj-title>
    <mj-preview>Log in with this magic link</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="-apple-system,BlinkMacSystemFont,&#x27;Segoe UI&#x27;,Roboto,Oxygen,Ubuntu,Cantarell,&#x27;Fira Sans&#x27;,&#x27;Droid Sans&#x27;,&#x27;Helvetica Neue&#x27;,sans-serif"
      />
      <mj-text padding="0px" />
    </mj-attributes>
    <mj-style>
      .notion-heading > div,
      .community-rich-0 > div,
      .community-rich-1 > div {
        line-height: normal !important;
      }
      p {
        margin: 0;
      }
      a {
        color: inherit;
      }
      .community-rich-0 a:nth-of-type(1) {
        color: #2754c5;
        text-decoration: underline;
      }
      .community-rich-1 code:nth-of-type(1) {
        display: block;
        padding: 16px 4.5%;
        background-color: #f4f4f4;
        border: 1px solid #eeeeee;
        border-radius: 6px;
        color: #333333;
      }
      .community-rich-2 a:nth-of-type(1) {
        color: #898989;
        font-size: 14px;
        text-decoration: underline;
      }
    </mj-style>
    <mj-style inline="inline">
      .reference-heading h1,
      .reference-heading h2 {
        margin: 0;
        font-family: inherit;
        font-size: inherit;
        font-weight: inherit;
        line-height: inherit;
        letter-spacing: inherit;
        color: inherit;
        text-transform: inherit;
      }
    </mj-style>
  </mj-head>
  <mj-body width="600px" background-color="#ffffff">
    <mj-section padding="0px 12px">
      <mj-column padding="0px">
        <mj-text
          padding="40px 0px"
          font-size="24px"
          line-height="1.3"
          font-weight="700"
          color="#333333"
          css-class="reference-heading notion-heading"
          ><h1>Login</h1></mj-text
        >
        <mj-text
          padding="0px 0px 16px"
          font-size="14px"
          line-height="1.5"
          css-class="community-rich-0"
          ><a href="https://notion.so/">Click here to log in with this magic link</a>
        </mj-text>
        <mj-text padding="8px 0px 14px" font-size="14px" line-height="24px" color="#333333"
          >Or, copy and paste this temporary login code:</mj-text
        >
        <mj-text padding="0px" font-size="13px" line-height="1.5" css-class="community-rich-1"
          ><code>sparo-ndigo-amurt-secan</code>
        </mj-text>
        <mj-text padding="14px 0px 16px" font-size="14px" line-height="24px" color="#ababab"
          >If you didn't try to login, you can safely ignore this email.</mj-text
        >
        <mj-text padding="0px 0px 38px" font-size="14px" line-height="24px" color="#ababab"
          >Hint: You can set a permanent password in Settings &amp; members → My account.</mj-text
        >
        <mj-image
          src="https://demo.react.email/static/notion-logo.png"
          alt="Notion&#x27;s Logo"
          width="32px"
          height="32px"
          align="left"
          padding="0px"
        />
        <mj-text
          padding="12px 0px 24px"
          font-size="12px"
          line-height="22px"
          color="#898989"
          css-class="community-rich-2"
          ><a href="https://notion.so/">Notion.so</a>, the all-in-one-workspace<br />for your notes,
          tasks, wikis, and databases.</mj-text
        >
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
