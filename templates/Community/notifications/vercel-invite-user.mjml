Public upstream PreviewProps only. See THIRD_PARTY_NOTICES.md for the MIT license. -->
<mjml>
  <mj-head>
    <mj-title>Join Alan on Vercel</mj-title>
    <mj-preview>Join Alan on Vercel</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial,Helvetica,sans-serif" />
      <mj-text padding="0px" />
    </mj-attributes>
    <mj-style>
      p {
        margin: 0;
      }
      a {
        color: inherit;
      }
      .community-rich-0 a:nth-of-type(1) {
        color: #2563eb;
        text-decoration: underline;
      }
      .community-rich-1 a:nth-of-type(1) {
        color: #2563eb;
        text-decoration: underline;
      }
    </mj-style>
  </mj-head>
  <mj-body width="465px" background-color="#ffffff">
    <mj-wrapper padding="20px" border="1px solid #eaeaea" border-radius="4px">
      <mj-section padding="32px 0px 0px">
        <mj-column padding="0px">
          <mj-image
            src="https://demo.react.email/static/vercel-logo.png"
            alt="Vercel Logo"
            width="40px"
            height="37px"
            align="center"
            padding="0px"
          />
          <mj-text
            padding="30px 0px"
            font-size="24px"
            line-height="1.3"
            font-weight="400"
            align="center"
            >Join <strong>Enigma</strong> on <strong>Vercel</strong>
          </mj-text>
          <mj-text padding="0px 0px 16px" font-size="14px" line-height="24px"
            >Hello alanturing,</mj-text
          >
          <mj-text
            padding="0px 0px 16px"
            font-size="14px"
            line-height="24px"
            css-class="community-rich-0"
            ><strong>Alan</strong> (<a href="mailto:alan.turing@example.com"
              >alan.turing@example.com</a
            >) has invited you to the <strong>Enigma</strong> team on
            <strong>Vercel</strong>.</mj-text
          >
        </mj-column>
      </mj-section>
      <mj-section padding="0px">
        <mj-column padding="0px" width="44%">
          <mj-image
            src="https://demo.react.email/static/vercel-user.png"
            alt="alanturing&#x27;s profile picture"
            width="64px"
            height="64px"
            align="right"
            padding="0px"
            border-radius="999px"
          />
        </mj-column>
        <mj-column padding="0px" width="12%" vertical-align="middle">
          <mj-image
            src="https://demo.react.email/static/vercel-arrow.png"
            alt="Arrow indicating invitation"
            width="12px"
            height="9px"
            align="center"
            padding="0px"
          />
        </mj-column>
        <mj-column padding="0px" width="44%">
          <mj-image
            src="https://demo.react.email/static/vercel-team.png"
            alt="Enigma team logo"
            width="64px"
            height="64px"
            align="left"
            padding="0px"
            border-radius="999px"
          />
        </mj-column>
      </mj-section>
      <mj-section padding="0px">
        <mj-column padding="0px">
          <mj-button
            href="https://vercel.com"
            align="center"
            padding="32px 0px"
            inner-padding="12px 20px"
            border-radius="4px"
            font-size="12px"
            background-color="#000000"
            color="#ffffff"
            font-weight="600"
            >Join the team</mj-button
          >
          <mj-text
            padding="0px 0px 16px"
            font-size="14px"
            line-height="24px"
            css-class="community-rich-1"
            >or copy and paste this URL into your browser:
            <a href="https://vercel.com/">https://vercel.com</a>
          </mj-text>
          <mj-divider border-color="#eaeaea" border-width="1px" padding="26px 0px" />
          <mj-text padding="0px 0px 16px" font-size="12px" line-height="24px" color="#666666"
            >This invitation was intended for alanturing. This invite was sent from 204.13.186.218
            located in São Paulo, Brazil. If you were not expecting this invitation, you can ignore
            this email. If you are concerned about your account's safety, please reply to this email
            to get in touch with us.</mj-text
          >
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
