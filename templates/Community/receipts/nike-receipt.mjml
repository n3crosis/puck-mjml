          line-height="1.3"
          font-weight="700"
          align="center"
          letter-spacing="-1px"
          >Top Picks For You</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section padding="20px 2px 22px">
      <mj-column padding="0px 2px" width="25%">
        <mj-image
          src="https://demo.react.email/static/nike-recomendation-1.png"
