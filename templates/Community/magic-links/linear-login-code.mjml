Public upstream PreviewProps only. See THIRD_PARTY_NOTICES.md for the MIT license. -->
<mjml>
  <mj-head>
    <mj-title>Your login code for Linear</mj-title>
    <mj-preview>Your login code for Linear</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="-apple-system,BlinkMacSystemFont,&#x27;Segoe UI&#x27;,Roboto,Oxygen-Sans,Ubuntu,Cantarell,&#x27;Helvetica Neue&#x27;,sans-serif"
      />
      <mj-text padding="0px" />
    </mj-attributes>
    <mj-style>
      p {
        margin: 0;
      }
      a {
        color: inherit;
      }
      .community-rich-0 code:nth-of-type(1) {
        font-family: monospace;
        font-weight: 700;
        padding: 1px 4px;
        background-color: #dfe1e4;
        border-radius: 4px;
      }
      .community-rich-1 a:nth-of-type(1) {
        color: #b4becc;
        text-decoration: underline;
      }
    </mj-style>
  </mj-head>
  <mj-body width="560px" background-color="#ffffff">
    <mj-section padding="20px 0px 48px">
      <mj-column padding="0px">
        <mj-image
          src="https://demo.react.email/static/linear-logo.png"
          alt="Linear"
          width="42px"
          height="42px"
          align="left"
          padding="0px"
          border-radius="24px"
        />
        <mj-text
          padding="34px 0px 0px"
          font-size="24px"
          line-height="1.3"
          font-weight="400"
          color="#484848"
          letter-spacing="-0.5px"
          >Your login code for Linear</mj-text
        >
        <mj-button
          href="https://linear.app"
          align="left"
          padding="27px 0px"
          inner-padding="11px 23px"
          border-radius="4px"
          font-size="15px"
          background-color="#5e6ad2"
          color="#ffffff"
          font-weight="600"
          width="100%"
          >Login to Linear</mj-button
        >
        <mj-text padding="0px 0px 15px" font-size="15px" line-height="1.4" color="#3c4149"
          >This link and code will only be valid for the next 5 minutes. If the link does not work,
          you can use the login verification code directly:</mj-text
        >
        <mj-text
          padding="0px"
          font-size="21px"
          line-height="1.5"
          letter-spacing="-0.3px"
          color="#3c4149"
          css-class="community-rich-0"
          ><code>tt226-5398x</code>
        </mj-text>
        <mj-divider border-color="#dfe1e4" border-width="1px" padding="42px 0px 26px" />
        <mj-text
          padding="0px 0px 16px"
          font-size="14px"
          line-height="1.5"
          css-class="community-rich-1"
          ><a href="https://linear.app/">Linear</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
