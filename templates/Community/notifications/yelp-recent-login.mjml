Public upstream PreviewProps only. See THIRD_PARTY_NOTICES.md for the MIT license. -->
<mjml>
  <mj-head>
    <mj-title>Yelp recent login</mj-title>
    <mj-preview>Yelp recent login</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="-apple-system,BlinkMacSystemFont,&#x27;Segoe UI&#x27;,Roboto,Oxygen-Sans,Ubuntu,Cantarell,&#x27;Helvetica Neue&#x27;,sans-serif"
      />
      <mj-text padding="0px" />
    </mj-attributes>
    <mj-style>
      p {
        margin: 0;
      }
      a {
        color: inherit;
      }
    </mj-style>
    <mj-style inline="inline">
      .reference-heading h1,
      .reference-heading h2 {
        margin: 0;
        font-family: inherit;
        font-size: inherit;
        font-weight: inherit;
        line-height: inherit;
        letter-spacing: inherit;
        color: inherit;
        text-transform: inherit;
      }
    </mj-style>
  </mj-head>
  <mj-body width="600px" background-color="#ffffff">
    <mj-section padding="30px 20px">
      <mj-column padding="0px">
        <mj-image
          src="https://demo.react.email/static/yelp-logo.png"
          alt="Yelp logo"
          width="120px"
          align="left"
          padding="0px"
        />
      </mj-column>
    </mj-section>
    <mj-wrapper padding="0px" border="1px solid #e6e6e6" border-radius="4px">
      <mj-section padding="0px">
        <mj-column padding="0px">
          <mj-image
            src="https://demo.react.email/static/yelp-header.png"
            alt="Yelp header illustration"
            width="620px"
            align="left"
            padding="0px"
          />
        </mj-column>
      </mj-section>
      <mj-section padding="20px">
        <mj-column padding="0px">
          <mj-text
            padding="0px 0px 16px"
            font-size="32px"
            line-height="1.3"
            font-weight="700"
            align="center"
            css-class="reference-heading"
            ><h1>Hi Alan,</h1></mj-text
          >
          <mj-text
            padding="0px 0px 16px"
            font-size="26px"
            line-height="1.3"
            font-weight="700"
            align="center"
            css-class="reference-heading"
            ><h2>We noticed a recent login to your Yelp account.</h2></mj-text
          >
          <mj-text padding="0px 0px 16px" font-size="16px" line-height="1.5"
            ><b>Time: </b>September 7, 2022 at 10:58 AM</mj-text
          >
          <mj-text padding="0px 0px 16px" font-size="16px" line-height="1.5"
            ><b>Device: </b>Chrome on Mac OS X</mj-text
          >
          <mj-text padding="0px 0px 16px" font-size="16px" line-height="1.5"
            ><b>Location: </b>Upland, California, United States</mj-text
          >
          <mj-text padding="0px 0px 16px" font-size="14px" line-height="24px" color="#808080"
            >*Approximate geographic location based on IP address:47.149.53.167</mj-text
          >
          <mj-text padding="0px 0px 16px" font-size="16px" line-height="1.5"
            >If this was you, there's nothing else you need to do.</mj-text
          >
          <mj-text padding="0px 0px 16px" font-size="16px" line-height="1.5"
            >If this wasn't you or if you have additional questions, please see our support
            page.</mj-text
          >
          <mj-button
            align="center"
            padding="0px 0px 16px"
            inner-padding="12px 30px"
            border-radius="4px"
            font-size="16px"
            background-color="#e00707"
            color="#ffffff"
            font-weight="700"
            border="1px solid #e6e6e6"
            >Learn More</mj-button
          >
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="45px 0px 12px">
      <mj-column padding="0px">
        <mj-image
          src="https://demo.react.email/static/yelp-footer.png"
          alt="Yelp footer decoration"
          width="620px"
          align="left"
          padding="0px"
        />
      </mj-column>
    </mj-section>
    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-text
          padding="0px 0px 16px"
          font-size="12px"
          line-height="24px"
          align="center"
          color="#4d4d4d"
          >© 2022 | Yelp Inc., 350 Mission Street, San Francisco, CA 94105, U.S.A. |
          www.yelp.com</mj-text
        >
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
