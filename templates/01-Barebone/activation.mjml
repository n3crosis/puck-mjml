https://github.com/resend/react-email/blob/674d8ec2804b86be5d99156383fb1810179847bf/apps/demo/emails/01-Barebone/activation.tsx
Canonical editable MJML. Public PreviewProps only; see ../README.md and ../../THIRD_PARTY_NOTICES.md. -->
<mjml lang="en"
  ><mj-head>
    <mj-title>We&#x27;re almost there!</mj-title><mj-preview>Confirm your email address</mj-preview>
    <mj-breakpoint width="601px" />
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&amp;display=swap"
    />
    <mj-attributes
      ><mj-all font-family="Inter, Arial, sans-serif" /><mj-section padding="0px" /><mj-column
        padding="0px" /><mj-text padding="0px" /><mj-image padding="0px" /><mj-button
        font-family="Inter, Arial, sans-serif"
    /></mj-attributes>
    <mj-style inline="inline">
      .bare-footer-copy > div {
        max-width: 280px;
        margin: 0 auto;
      }
      .bare-copy > div {
        max-width: 380px;
        margin: 0 auto;
      }
      .bare-note > div {
        max-width: 400px;
        margin: 0 auto;
      }
      .bare-heading-copy > div {
        max-width: 422px;
        margin: 0 auto;
      }
      .bare-shell a {
        color: inherit;
      }
      .bare-gap > div {
        display: block;
      }
    </mj-style>
    <mj-style>
      @media only screen and (max-width: 600px) {
        .bare-top-space {
          display: none !important;
        }
        .bare-shell > table > tbody > tr > td {
          padding-left: 8px !important;
          padding-right: 8px !important;
        }
        .bare-card-section > table > tbody > tr > td {
          padding-left: 24px !important;
          padding-right: 24px !important;
        }
      }
    </mj-style>
    <mj-style inline="inline">
      .reference-heading h1,
      .reference-heading h2 {
        margin: 0;
        font-family: inherit;
        font-size: inherit;
        font-weight: inherit;
        line-height: inherit;
        letter-spacing: inherit;
        color: inherit;
        text-transform: inherit;
      }
    </mj-style>
    <mj-style>
      @media only screen and (max-width: 600px) {
        .bare-card-section > table > tbody > tr > td {
          padding-top: 48px !important;
          padding-bottom: 48px !important;
        }
      }
    </mj-style> </mj-head
  ><mj-body width="640px" background-color="#F3F4F6">
    <mj-section padding="0px" css-class="bare-top-space"
      ><mj-column><mj-spacer height="32px" /></mj-column
    ></mj-section>
    <mj-wrapper background-color="#FFFFFF" padding="16px 24px" css-class="bare-shell">
      <mj-section padding="0px 24px 12px"
        ><mj-group width="100%"
          ><mj-column width="50%" padding="7px 0px"
            ><mj-image
              src="https://demo.react.email/static/shared/logo-black.png"
              alt=""
              width="23px"
              padding="0px 0px 0px"
              border-radius="0px"
              align="left" /></mj-column
          ><mj-column width="50%" padding="7px 0px"
            ><mj-text
              font-size="13px"
              font-weight="420"
              line-height="1.5"
              letter-spacing="-0.039px"
              color="#7B7D81"
              align="right"
              padding="0px 0px 0px"
              >Barebones</mj-text
            ></mj-column
          ></mj-group
        ></mj-section
      >
      <mj-section
        padding="64px 40px 64px"
        background-color="#F3F4F6"
        border-radius="10px"
        css-class="bare-card-section"
        ><mj-column width="100%" padding="0px"
          ><mj-image
            src="https://demo.react.email/static/shared/logo-black.png"
            alt=""
            width="48px"
            padding="0px 0px 20px"
            border-radius="0px"
          /><mj-text
            font-size="28px"
            font-weight="600"
            line-height="1.3"
            letter-spacing="-0.084px"
            color="#14171E"
            align="center"
            padding="0px 0px 12px"
            css-class="reference-heading"
            ><h1>We&#x27;re almost there!</h1></mj-text
          ><mj-text
            font-size="16px"
            font-weight="420"
            line-height="1.5"
            letter-spacing="-0.048px"
            color="#43454B"
            align="center"
            padding="0px 0px 32px"
            css-class="bare-copy"
            >Thank you for signing up for Barebones.<br />To verify your account, we just need to
            confirm your email address.</mj-text
          ><mj-button
            href="https://example.com/"
            background-color="#14171E"
            color="#FFFFFF"
            font-size="16px"
            font-weight="420"
            line-height="1.2"
            letter-spacing="-0.048px"
            border-radius="8px"
            inner-padding="16px 28px"
            padding="0px 0px 24px"
            align="center"
            >Confirm email</mj-button
          ><mj-spacer height="8px" /><mj-text
            font-size="13px"
            font-weight="420"
            line-height="1.5"
            letter-spacing="-0.039px"
            color="#7B7D81"
            align="center"
            padding="0px 0px 0px"
            css-class="bare-note"
            >If you didn't request this,<br />please ignore this email.</mj-text
          ></mj-column
        ></mj-section
      >
      <mj-section padding="40px 24px"
        ><mj-column width="100%" padding="0px"
          ><mj-text
            font-size="13px"
            font-weight="420"
            line-height="1.5"
            letter-spacing="-0.039px"
            color="#7B7D81"
            align="center"
            padding="0px 0px 32px"
            css-class="bare-footer-copy"
            >Barebones is the catchy slogan that perfectly encapsulates the vision of our
            company.</mj-text
          ><mj-social
            mode="horizontal"
            icon-size="18px"
            icon-padding="0px"
            border-radius="0px"
            padding="0px 0px 32px"
            align="center"
            ><mj-social-element
              name="web"
              src="https://demo.react.email/static/shared/social-x-black.png"
              href="https://example.com/"
              alt="X"
              background-color="transparent"
              padding="0px 8px"
              icon-size="18px"
              icon-height="18px"
            ></mj-social-element
            ><mj-social-element
              name="web"
              src="https://demo.react.email/static/shared/social-in-black.png"
              href="https://example.com/"
              alt="LinkedIn"
              background-color="transparent"
              padding="0px 8px"
              icon-size="18px"
              icon-height="18px"
            ></mj-social-element
            ><mj-social-element
              name="web"
              src="https://demo.react.email/static/shared/social-yt-black.png"
              href="https://example.com/"
              alt="YouTube"
              background-color="transparent"
              padding="0px 8px"
              icon-size="18px"
              icon-height="18px"
            ></mj-social-element
            ><mj-social-element
              name="web"
              src="https://demo.react.email/static/shared/social-gh-black.png"
              href="https://example.com/"
              alt="GitHub"
              background-color="transparent"
              padding="0px 8px"
              icon-size="18px"
              icon-height="18px"
            ></mj-social-element></mj-social
          ><mj-text
            font-size="11px"
            font-weight="420"
            line-height="1.5"
            letter-spacing="-0.033px"
            color="#7B7D81"
            align="center"
            padding="0px 0px 20px"
            >123 Market Street, Floor 1<br />Tech City, CA, 94102</mj-text
          ><mj-text
            font-size="11px"
            font-weight="420"
            line-height="1.5"
            letter-spacing="-0.033px"
            color="#7B7D81"
            align="center"
            padding="0px 0px 0px"
            ><a href="https://example.com/">Unsubscribe</a> from Barebones marketing
            emails.</mj-text
          ></mj-column
        ></mj-section
      >
    </mj-wrapper></mj-body
  ></mjml
>
