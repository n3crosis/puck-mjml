Public upstream PreviewProps only. See THIRD_PARTY_NOTICES.md for the MIT license. -->
<mjml>
  <mj-head>
    <mj-title>Dropbox reset your password</mj-title>
    <mj-preview>Dropbox reset your password</mj-preview>
    <mj-attributes>
      <mj-all font-family="inherit" />
      <mj-text padding="0px" font-weight="300" color="#404040" />
    </mj-attributes>
    <mj-style>
      .dropbox-reset-button a {
        font-family:
          Open Sans,
          Helvetica Neue,
          Arial !important;
      }
      p {
        margin: 0;
      }
      a {
        color: inherit;
      }
      body {
        font-family:
          Open Sans,
          HelveticaNeue-Light,
          Helvetica Neue Light,
          Helvetica Neue,
          Helvetica,
          Arial,
          Lucida Grande,
          sans-serif !important;
        padding: 18px 8px !important;
      }
      .community-rich-0 a:nth-of-type(1) {
        color: #067df7;
        text-decoration: underline;
      }
    </mj-style>
  </mj-head>
  <mj-body width="600px" background-color="#f6f9fc">
    <mj-section padding="45px" background-color="#ffffff" border="1px solid #f0f0f0">
      <mj-column padding="0px">
        <mj-image
          src="https://demo.react.email/static/dropbox-logo.png"
          alt="Dropbox"
          width="40px"
          height="33px"
          align="left"
          padding="0px"
        />
        <mj-text padding="16px 0px" font-size="16px" line-height="26px">Hi Alan,</mj-text>
        <mj-text padding="0px 0px 16px" font-size="16px" line-height="26px"
          >Someone recently requested a password change for your Dropbox account. If this was you,
          you can set a new password here:</mj-text
        >
        <mj-button
          href="https://www.dropbox.com"
          align="left"
          padding="0px 0px 16px"
          inner-padding="14px 7px"
          border-radius="4px"
          font-size="15px"
          font-family="inherit"
          css-class="dropbox-reset-button"
          line-height="120%"
          background-color="#007ee6"
          color="#ffffff"
          width="224px"
          >Reset password</mj-button
        >
        <mj-text padding="0px 0px 16px" font-size="16px" line-height="26px"
          >If you don't want to change your password or didn't request this, just ignore and delete
          this message.</mj-text
        >
        <mj-text
          padding="0px 0px 16px"
          font-size="16px"
          line-height="26px"
          css-class="community-rich-0"
          >To keep your account secure, please don't forward this email to anyone. See our Help
          Center for <a href="https://www.dropbox.com/">more security tips.</a>
        </mj-text>
        <mj-text padding="0px 0px 16px" font-size="16px" line-height="26px"
          >Happy Dropboxing!</mj-text
        >
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
