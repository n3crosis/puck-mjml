        >
      </mj-column>
    </mj-section>
    <mj-section padding="22px 40px" background-color="#F7F7F7">
      <mj-column padding="0px" width="33.333%">
        <mj-text
          padding="0px"
          font-size="13.5px"
          line-height="1.5"
          font-weight="500"
          css-class="community-rich-0"
