{
  "name": "puck-mjml",
  "version": "0.1.0",
  "description": "A Puck powered visual editor for MJML email",
  "license": "MIT",
  "files": [
    "dist",
    "docs",
    "templates",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json && node scripts/build-declarations.mjs",
    "build:demo": "vite build --mode demo --base=./",
    "catalog": "bun scripts/regenerate-native-catalog.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src demo tests/browser vite.config.ts playwright.config.ts scripts/smoke-package.mjs scripts/build-declarations.mjs",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "typecheck": "tsc --noEmit",
    "test": "bun run references:prepare && vitest run",
    "test:package": "node scripts/smoke-package.mjs",
    "test:browser": "bun run references:prepare && playwright test",
    "references:prepare": "bun scripts/render-react-email-references/prepare.mjs",
    "references:verify": "node scripts/render-react-email-references/verify.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@noble/hashes": "2.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "cheerio": "^1.2.0",
    "mjml-browser": "^5.4.1",
    "postcss": "8.5.31",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@puckeditor/core": "^0.24.0",
    "@tailwindcss/browser": "^4.3.3",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "21.0.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@puckeditor/core": "^0.24.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "overrides": {
    "happy-dom": "21.0.4"
  },
  "packageManager": "bun@1.4.2"
}
