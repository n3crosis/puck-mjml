{
  "name": "puck-mjml",
  "version": "1.0.0",
  "description": "A Puck powered visual editor for MJML email",
  "homepage": "https://github.com/n3crosis/puck-mjml#readme",
  "bugs": {
    "url": "https://github.com/n3crosis/puck-mjml/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n3crosis/puck-mjml.git"
  },
  "files": [
    "dist",
    "docs",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": {
      "types": "./dist/style.d.cts",
      "default": "./dist/style.css"
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json && node scripts/build-declarations.mjs",
    "prepack": "npm run build",
    "build:demo": "vite build --mode demo --base=./",
    "catalog": "bun scripts/regenerate-native-catalog.ts && oxfmt src/native-catalog.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src demo tests scripts/*.ts vite.config.ts playwright.config.ts scripts/smoke-package.mjs scripts/build-declarations.mjs scripts/smoke-peers.mjs scripts/smoke-richtext-runtime.mjs",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "typecheck": "tsc --noEmit",
    "test": "bun run references:prepare && vitest run",
    "test:package": "node scripts/smoke-package.mjs",
    "test:package:peers": "node scripts/smoke-peers.mjs",
    "test:browser": "bun run references:prepare && playwright test",
    "references:prepare": "bun scripts/render-react-email-references/prepare.mjs",
    "references:verify": "node scripts/render-react-email-references/verify.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-bold": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@noble/hashes": "2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.65.1",
    "@puckeditor/core": "^0.24.2",
    "@tailwindcss/browser": "^4.3.5",
    "@tiptap/extension-document": "^3.35.0",
    "@tiptap/extension-paragraph": "^3.35.0",
    "@tiptap/extension-text": "^3.35.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.3.0",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "mjml-browser": "^5.4.1",
    "oxc-parser": "^0.160.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "postcss": "8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@puckeditor/core": "^0.24.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.4.2"
}
