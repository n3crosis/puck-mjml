<mjml lang="en"
  ><mj-head>
    <mj-title>Here&#x27;s what&#x27;s new with Barebones</mj-title
    ><mj-preview>Product update: what&#x27;s new at Barebones</mj-preview>
    <mj-breakpoint width="601px" />
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&amp;display=swap"
    />
    <mj-style>
      /* Exact static registrations from the pinned BarebonesFonts component.
         Keep the original declared weights, including the 400 face URL. */
      @font-face {
        font-family: "Inter";
        font-style: normal;
        font-weight: 400;
        mso-font-alt: "Arial";
        src: url("https://fonts.gstatic.com/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuOKfMZg.ttf")
          format("truetype");
      }
      @font-face {
        font-family: "Inter";
        font-style: normal;
        font-weight: 500;
        mso-font-alt: "Arial";
        src: url("https://fonts.gstatic.com/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuI6fMZg.ttf")
          format("truetype");
      }
      @font-face {
        font-family: "Inter";
        font-style: normal;
        font-weight: 600;
        mso-font-alt: "Arial";
        src: url("https://fonts.gstatic.com/s/inter/v20/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuGKYMZg.ttf")
          format("truetype");
      }
    </mj-style>
    <mj-attributes
      ><mj-all font-family="Inter, Arial, sans-serif" /><mj-section padding="0px" /><mj-column
        padding="0px" /><mj-text padding="0px" /><mj-image padding="0px" /><mj-button
        font-family="Inter, Arial, sans-serif"
    /></mj-attributes>
    <mj-style inline="inline">
      .bare-app-icon {
        width: 56px !important;
        max-width: 56px !important;
      }
      .bare-footer-copy > div {
        max-width: 280px;
        margin: 0 auto;
      }
      .bare-copy > div {
        max-width: 380px;
        margin: 0 auto;
      }
      .bare-note > div {
        max-width: 400px;
        margin: 0 auto;
      }
      .bare-heading-copy > div {
        max-width: 422px;
        margin: 0 auto;
      }
      .bare-plain-link a {
        text-decoration: none;
      }
      .bare-shell a {
        color: inherit;
      }
      .bare-gap > div {
        display: block;
      }
    </mj-style>
    <mj-style>
      @media only screen and (max-width: 600px) {
        .bare-top-space {
          display: none !important;
        }
        .bare-shell > table > tbody > tr > td {
          padding-left: 8px !important;
          padding-right: 8px !important;
        }
        .bare-card-section > table > tbody > tr > td {
          padding-left: 16px !important;
          padding-right: 16px !important;
        }
      }
    </mj-style>
    <mj-style inline="inline">
      .reference-heading h1,
      .reference-heading h2 {
        margin: 0;
        font-family: inherit;
        font-size: inherit;
        font-weight: inherit;
        line-height: inherit;
        letter-spacing: inherit;
        color: inherit;
        text-transform: inherit;
      }
    </mj-style>
    <mj-style inline="inline">
      /* The source images fill fractional-width table cells. MJML's pixel
         image table would otherwise round each alternating row down. */
      .bare-alternating-image table {
        width: 100% !important;
      }
      .bare-alternating-column a {
        text-decoration: none;
      }
      .bare-step-slot {
        width: 52px !important;
        flex-basis: 52px !important;
      }
      .bare-step-body {
        width: calc(100% - 52px) !important;
        flex-basis: calc(100% - 52px) !important;
      }
      .bare-step-number p {
        margin: 0 auto;
        width: 28px;
        box-sizing: border-box;
        border: 1px solid #e4e4e7;
        border-radius: 10px;
        padding: 4px 0;
        font-size: 14px;
        line-height: 20px;
        font-weight: 400;
      }
      .bare-bullet-square p {
        margin: 0;
        width: 24px;
        height: 24px;
        box-sizing: content-box;
        border: 1px solid #e4e4e7;
        border-radius: 8px;
        font-size: 1px;
        line-height: 24px;
      }
    </mj-style>
    <mj-style>
      @media only screen and (max-width: 600px) {
        .bare-hero > table > tbody > tr > td {
          padding-bottom: 16px !important;
        }
        .bare-alternating-column > table > tbody > tr > td {
