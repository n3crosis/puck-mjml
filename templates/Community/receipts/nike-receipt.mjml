<mjml>
  <mj-head>
    <mj-title>Your Nike order is on its way</mj-title>
    <mj-preview>Get your order summary, estimated delivery date and more</mj-preview>
    <mj-attributes>
      <mj-all
        font-family="-apple-system,BlinkMacSystemFont,&#x27;Segoe UI&#x27;,Roboto,Oxygen-Sans,Ubuntu,Cantarell,&#x27;Helvetica Neue&#x27;,sans-serif"
      />
      <mj-text padding="0px" />
    </mj-attributes>
    <mj-style>
      p {
        margin: 0;
      }
      a {
        color: inherit;
      }
      .community-rich-0 a:nth-of-type(1) {
        color: #000000;
        text-decoration: underline;
      }
      .community-rich-1 a:nth-of-type(1) {
        color: #000000;
        text-decoration: underline;
      }
      .community-rich-2 a:nth-of-type(1) {
        color: #000000;
        text-decoration: underline;
      }
      .community-rich-3 a:nth-of-type(1) {
        color: #000000;
        text-decoration: underline;
      }
      .community-rich-4 a:nth-of-type(1) {
        color: #000000;
        text-decoration: underline;
      }
      .community-rich-5 a:nth-of-type(1) {
        color: #000000;
        text-decoration: underline;
      }
      .community-rich-6 a:nth-of-type(1) {
        color: #000000;
        text-decoration: underline;
      }
      .community-rich-7 a:nth-of-type(1) {
        color: #000000;
        text-decoration: underline;
      }
      .community-rich-8 a:nth-of-type(1) {
        color: #000000;
        text-decoration: underline;
      }
    </mj-style>
  </mj-head>
  <mj-body width="600px" background-color="#ffffff">
    <mj-section padding="22px 40px" background-color="#F7F7F7">
      <mj-column padding="0px" width="50%">
        <mj-text padding="0px" font-size="14px" line-height="2" font-weight="700"
          >Tracking Number</mj-text
        >
        <mj-text
          padding="12px 0px 0px"
          font-size="14px"
          line-height="1.4"
          font-weight="500"
          color="#6F6F6F"
          >1ZV218970300071628</mj-text
        >
      </mj-column>
      <mj-column padding="0px" width="50%" vertical-align="middle">
        <mj-button
          align="right"
          padding="0px"
          inner-padding="10px 0px"
          border-radius="0px"
          font-size="16px"
          background-color="#F7F7F7"
          color="#000000"
          border="1px solid #929292"
          font-weight="500"
          width="220px"
          >Track Package</mj-button
        >
      </mj-column>
    </mj-section>
    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-divider border-color="#E5E5E5" border-width="1px" padding="0px" />
      </mj-column>
    </mj-section>
    <mj-section padding="40px 74px">
      <mj-column padding="0px">
        <mj-image
          src="https://demo.react.email/static/nike-logo.png"
          alt="Nike"
          width="66px"
          height="22px"
          align="center"
          padding="0px"
        />
        <mj-text
          padding="32px 0px"
          font-size="32px"
          line-height="1.3"
          font-weight="700"
          align="center"
          letter-spacing="-1px"
          >It's On Its Way.</mj-text
        >
        <mj-text
          padding="0px"
          font-size="14px"
          line-height="2"
          color="#747474"
          font-weight="500"
          align="center"
          >Your order is on its way. Use the link above to track its progress.</mj-text
        >
        <mj-text
          padding="24px 0px 0px"
          font-size="14px"
          line-height="2"
          color="#747474"
          font-weight="500"
          align="center"
          >We´ve also charged your payment method for the cost of your order and will be removing
          any authorization holds. For payment details, please visit your Orders page on Nike.com or
          in the Nike app.</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-divider border-color="#E5E5E5" border-width="1px" padding="0px" />
      </mj-column>
    </mj-section>
    <mj-section padding="22px 40px">
      <mj-column padding="0px">
        <mj-text padding="0px" font-size="15px" line-height="2" font-weight="700"
          >Shipping to: Alan Turing</mj-text
        >
        <mj-text padding="0px" font-size="14px" line-height="2" font-weight="500" color="#747474"
          >2125 Chestnut St, San Francisco, CA 94123</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-divider border-color="#E5E5E5" border-width="1px" padding="0px" />
      </mj-column>
    </mj-section>
    <mj-section padding="40px">
      <mj-column padding="0px" width="50%">
        <mj-image
          src="https://demo.react.email/static/nike-product.png"
          alt="Brazil 2022/23 Stadium Away Women&#x27;s Nike Dri-FIT Soccer Jersey"
          width="260px"
          align="left"
          padding="0px"
        />
      </mj-column>
      <mj-column padding="0px 0px 0px 12px" width="50%">
        <mj-text padding="0px" font-size="14px" line-height="2" font-weight="500"
          >Brazil 2022/23 Stadium Away Women's Nike Dri-FIT Soccer Jersey</mj-text
        >
        <mj-text padding="0px" font-size="14px" line-height="2" font-weight="500" color="#747474"
          >Size L (12–14)</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-divider border-color="#E5E5E5" border-width="1px" padding="0px" />
      </mj-column>
    </mj-section>
    <mj-section padding="22px 40px 40px">
      <mj-column padding="0px" width="33%">
        <mj-text padding="0px" font-size="14px" line-height="2" font-weight="700"
