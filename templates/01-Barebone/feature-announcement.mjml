<mjml lang="en"
  ><mj-head>
    <mj-title>Release Notes</mj-title><mj-preview>Release notes — Barebones</mj-preview>
    <mj-breakpoint width="601px" />
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&amp;display=swap"
    />
    <mj-attributes
      ><mj-all font-family="Inter, Arial, sans-serif" /><mj-section padding="0px" /><mj-column
        padding="0px" /><mj-text padding="0px" /><mj-image padding="0px" /><mj-button
        font-family="Inter, Arial, sans-serif"
    /></mj-attributes>
    <mj-style inline="inline">
      .bare-app-icon {
        width: 56px !important;
        max-width: 56px !important;
      }
      .bare-footer-copy > div {
        max-width: 280px;
        margin: 0 auto;
      }
      .bare-copy > div {
        max-width: 380px;
        margin: 0 auto;
      }
      .bare-note > div {
        max-width: 400px;
        margin: 0 auto;
      }
      .bare-heading-copy > div {
        max-width: 422px;
        margin: 0 auto;
      }
      .bare-app-copy > div {
        max-width: 420px;
        margin: 0 auto;
      }
      .bare-shell a {
        color: inherit;
      }
      .bare-gap > div {
        display: block;
      }
    </mj-style>
    <mj-style>
      @media only screen and (max-width: 600px) {
        .bare-top-space {
          display: none !important;
        }
        .bare-shell > table > tbody > tr > td {
          padding-left: 8px !important;
          padding-right: 8px !important;
        }
        .bare-card-section > table > tbody > tr > td {
          padding-left: 16px !important;
          padding-right: 16px !important;
        }
        .bare-stack-gap {
          padding-bottom: 32px !important;
        }
      }
    </mj-style>
    <mj-style inline="inline">
      .reference-heading h1,
      .reference-heading h2 {
        margin: 0;
        font-family: inherit;
        font-size: inherit;
        font-weight: inherit;
        line-height: inherit;
        letter-spacing: inherit;
        color: inherit;
        text-transform: inherit;
      }
    </mj-style> </mj-head
  ><mj-body width="640px" background-color="#F3F4F6">
    <mj-section padding="0px" css-class="bare-top-space"
