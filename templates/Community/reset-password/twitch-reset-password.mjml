<mjml>
  <mj-head>
    <mj-title>You updated the password for your Twitch account</mj-title>
    <mj-preview>You updated the password for your Twitch account</mj-preview>
    <mj-attributes>
      <mj-all font-family="HelveticaNeue,Helvetica,Arial,sans-serif" />
      <mj-text padding="0px" />
    </mj-attributes>
    <mj-style inline="inline">
      p {
        margin: 0;
      }
      a {
        color: inherit;
      }
      .community-rich-0 a:nth-of-type(1) {
        color: #067df7;
        text-decoration: underline;
      }
      .community-rich-1 a:nth-of-type(1) {
        color: #067df7;
        text-decoration: underline;
      }
      .community-rich-2 a:nth-of-type(1) {
        color: #067df7;
        text-decoration: underline;
      }
    </mj-style>
  </mj-head>
  <mj-body width="580px" background-color="#efeef1">
    <mj-wrapper padding="30px 0px">
      <mj-section padding="30px" background-color="#ffffff">
        <mj-column padding="0px">
          <mj-image
            src="https://demo.react.email/static/twitch-logo.png"
            alt="Twitch"
            width="114px"
            align="center"
            padding="0px"
          />
        </mj-column>
      </mj-section>
      <mj-section padding="0px" background-color="#ffffff">
        <mj-group>
          <mj-column padding="0px" width="41.5%">
            <mj-divider border-color="#eeeeee" border-width="1px" padding="0px" />
          </mj-column>
          <mj-column padding="0px" width="17%">
            <mj-divider border-color="#9147ff" border-width="1px" padding="0px" />
          </mj-column>
          <mj-column padding="0px" width="41.5%">
            <mj-divider border-color="#eeeeee" border-width="1px" padding="0px" />
          </mj-column>
        </mj-group>
      </mj-section>
      <mj-section padding="21px 20px 10px" background-color="#ffffff">
        <mj-column padding="0px">
          <mj-text padding="0px 0px 16px" font-size="14px" line-height="1.5"
            >Hi alanturing,</mj-text
          >
          <mj-text padding="0px 0px 16px" font-size="14px" line-height="1.5"
            >You updated the password for your Twitch account on Jun 23, 2022, 4:06:00 PM. If this
            was you, then no further action is required.</mj-text
          >
          <mj-text
            padding="0px 0px 16px"
            font-size="14px"
            line-height="1.5"
            css-class="community-rich-0"
            >However if you did NOT perform this password change, please
            <a href="https://www.twitch.tv/">reset your account password</a> immediately.</mj-text
          >
          <mj-text
            padding="0px 0px 16px"
            font-size="14px"
            line-height="1.5"
            css-class="community-rich-1"
            >Remember to use a password that is both strong and unique to your Twitch account. To
            learn more about how to create a strong and unique password,
            <a href="https://www.twitch.tv/">click here.</a>
          </mj-text>
          <mj-text
            padding="0px 0px 16px"
            font-size="14px"
            line-height="1.5"
            css-class="community-rich-2"
            >Still have questions? Please contact
            <a href="https://www.twitch.tv/">Twitch Support</a>
          </mj-text>
          <mj-text padding="0px 0px 16px" font-size="14px" line-height="1.5"
            >Thanks,<br />Twitch Support Team</mj-text
          >
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="0px 0px 16px">
      <mj-group>
        <mj-column padding="0px 8px 0px 0px" width="50%">
          <mj-image
            src="https://demo.react.email/static/twitch-icon-twitter.png"
            alt="Twitter"
            width="24px"
            height="20px"
            align="right"
            padding="0px"
          />
        </mj-column>
        <mj-column padding="0px 0px 0px 8px" width="50%">
          <mj-image
            src="https://demo.react.email/static/twitch-icon-facebook.png"
            alt="Facebook"
            width="11px"
            height="20px"
            align="left"
            padding="0px"
          />
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section padding="0px">
      <mj-column padding="0px">
        <mj-text
          padding="0px 0px 16px"
          font-size="14px"
          line-height="24px"
          align="center"
          color="#706a7b"
          >© 2022 Twitch, All Rights Reserved<br />350 Bush Street, 2nd Floor, San Francisco, CA,
          94104 - USA</mj-text
        >
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
